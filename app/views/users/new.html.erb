<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%= t('general.create_account') %></h1>

  <%= simple_form_for @user, url: sign_up_path, class: "contents", local: true do |form| %>
    <div class="my-5">
      <%= form.input :email_address, input_html: { class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" }, placeholder: t('placeholders.user.email_address') %>
    </div>

    <div class="my-5">
      <%= form.input :password, input_html: { class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" }, placeholder: t('placeholders.user.password') %>
    </div>
    
    <div class="my-5">
      <%= form.input :password_confirmation, input_html: { class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" }, placeholder: t('placeholders.user.password_confirmation') %>
    </div>

    <div class="my-5">
      <%= form.submit t('buttons.submit.create_account'), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>
</div>



