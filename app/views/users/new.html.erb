<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-100 via-purple-100 to-gray-200">
  <div class="mx-auto w-full max-w-md px-4 sm:px-6 py-8 bg-white rounded-xl shadow-xl border border-gray-200">
    <h1 class="text-3xl font-semibold text-gray-900 text-center mb-8" style="font-family: 'Inter', sans-serif;"><%= t('general.create_account') %></h1>

    <%= simple_form_for @user, url: sign_up_path, html: { class: "space-y-6" }, local: true do |form| %>
      <div class="relative">
        <%= form.input :email_address, 
                       label_html: { class: "block text-sm font-medium text-gray-700" },
                       input_html: { 
                         class: "mt-1 block w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200 ease-in-out text-gray-900",
                         autocomplete: "email",
                         placeholder: t('placeholders.user.email_address')
                       } %>
        <div class="absolute inset-y-0 left-0 top-6 flex items-center pl-3">
          <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <use xlink:href="#icon-email"/>
          </svg>
        </div>
      </div>

      <div class="relative">
        <%= form.input :password, 
                       label_html: { class: "block text-sm font-medium text-gray-700" },
                       input_html: { 
                         class: "mt-1 block w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200 ease-in-out text-gray-900",
                         autocomplete: "new-password",
                         placeholder: t('placeholders.user.password')
                       } %>
        <div class="absolute inset-y-0 left-0 top-6 flex items-center pl-3">
          <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <use xlink:href="#icon-lock"/>
          </svg>
        </div>
      </div>

      <div class="relative">
        <%= form.input :password_confirmation, 
                       label_html: { class: "block text-sm font-medium text-gray-700" },
                       input_html: { 
                         class: "mt-1 block w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200 ease-in-out text-gray-900",
                         autocomplete: "new-password",
                         placeholder: t('placeholders.user.password_confirmation')
                       } %>
        <div class="absolute inset-y-0 left-0 top-6 flex items-center pl-3">
          <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <use xlink:href="#icon-lock"/>
          </svg>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <%= form.submit t('buttons.submit.create_account'), class: "w-full sm:w-auto px-6 py-3 bg-violet-600 text-white font-semibold rounded-full shadow-md hover:bg-violet-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition duration-200 ease-in-out", style: "font-family: 'Inter', sans-serif;" %>
        <%= link_to 'Já possuo uma conta', new_session_path, class: 'text-sm text-blue-600 hover:text-blue-700 font-medium underline hover:no-underline transition duration-200 ease-in-out', style: "font-family: 'Inter', sans-serif;" %>
      </div>
    <% end %>
  </div>
</div>