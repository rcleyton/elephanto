<div class="grid gap-6 md:grid-cols-2 mb-6">
  <div class="rounded-lg border bg-card text-card-foreground">
    <div class="flex flex-col space-y-1.5 p-6">
      <h3 class="text-2xl font-semibold leading-none tracking-tight">
        Você tem
        <%= @total_due_count %>
        flashcards para revisar</h3>
      <p class="text-sm text-muted-foreground">Flashcards para revisão por deck</p>
    </div>
    <div class="p-6 pt-0">
      <%= pie_chart @due_flashcards_by_deck, height: "250px", suffix: " flashcards" %>
    </div>
  </div>
  <div class="rounded-lg border bg-card text-card-foreground">
    <div class="flex flex-col space-y-1.5 p-6">
      <h3 class="text-2xl font-semibold leading-none tracking-tight">
        Quantidade de revisões por dia
      </h3>
      <p class="text-sm text-muted-foreground">Frequência revisões diárias</p>
    </div>
    <div class="p-6 pt-0">
      <%= line_chart @review_sessions.group_by_day(:started_at).count,
      height: "250px",
      suffix: " Revisões" %>
    </div>
  </div>
</div>
