<div class="min-h-screen flex items-center px-4 sm:px-6 justify-center bg-gradient-to-br from-blue-100 via-purple-100 to-gray-200">
  <div class="mx-auto w-full max-w-md px-4 sm:px-6 py-8 bg-white rounded-xl shadow-xl border border-gray-200">
    <turbo-frame id="flash">
      <%= render "shared/flash" %>
    </turbo-frame>

    <h1 class="text-3xl font-semibold text-gray-900 text-center mb-8" style="font-family: 'Inter', sans-serif;"><%= t('general.signin') %></h1>

    <%= form_with url: session_url, class: "space-y-6" do |form| %>
      <div class="relative">
        <%= form.label 'Email', class: "block text-sm font-medium text-gray-700" %>
        <div class="absolute inset-y-0 left-0 top-6 flex items-center pl-3">
          <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <use xlink:href="#icon-email"/>
          </svg>
        </div>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: t('placeholders.user.email_address'), value: params[:email_address], class: "mt-1 block w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200 ease-in-out text-gray-900" %>
      </div>

      <div class="relative">
        <%= form.label 'Senha', class: "block text-sm font-medium text-gray-700" %>
        <div class="absolute inset-y-0 left-0 top-6 flex items-center pl-3">
          <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <use xlink:href="#icon-lock"/>
          </svg>
        </div>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: t('placeholders.user.password'), maxlength: 72, class: "mt-1 block w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200 ease-in-out text-gray-900" %>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <%= form.submit t('buttons.general.enter'), class: "w-full sm:w-auto px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg shadow-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition duration-200 ease-in-out", style: "font-family: 'Inter', sans-serif;" %>

        <div class="text-sm text-gray-600">
          <%= link_to t('buttons.general.forgot_password'), new_password_path, class: "text-blue-600 hover:text-blue-700 font-medium underline hover:no-underline transition duration-200 ease-in-out", style: "font-family: 'Inter', sans-serif;" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
