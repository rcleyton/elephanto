<div class="min-h-screen flex overflow-hidden">
  <turbo-frame id="flash"> 
    <%= render "shared/flash" %>
  </turbo-frame>
  <div class="hidden lg:flex lg:w-1/2 bg-gradient-primary items-center justify-center p-8 bg-emerald-400">
    <div class="text-center text-white">
        <h1 class="text-4xl font-bold mb-4">Bem vindo de volta ao Elephanto</h1>
        <p class="text-xl opacity-90">
          Aprenda com inteligência usando repetição espaçada
        </p>
        <div class="mt-8">
          <%= image_tag "logo_ligth.svg", class: "w-48 h-48 mx-auto filter brightness-0 invert" %>
        </div>
    </div>
  </div>
  <div class="flex-1 flex items-center justify-center p-8 bg-gray-100">
    <div class="rounded-lg border border-gray-300 bg-white text-gray-900 shadow-sm w-full max-w-md">
      <div class="flex flex-col space-y-1.5 p-6 text-center">
        <div>
          <h3 class="text-2xl font-semibold leading-none tracking-tight"><%= t('general.signin') %></h3>
          <p class="text-sm text-gray-500 mt-2">Entre e aprenda um pouco mais ainda hoje</p>
        </div>
      </div>
      <div class="p-6 pt-0">
        <%= form_with url: session_url, class: "space-y-4" do |form| %>
          <div class="space-y-2">
            <%= form.label 'Email', class: "text-sm font-medium leading-none" %>
            <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: t('placeholders.user.email_address'), value: params[:email_address], class: "flex h-10 w-full rounded-md border border-gray-300 bg-white px-3 py-2 mt-2 text-base placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-white disabled:cursor-not-allowed disabled:opacity-50 md:text-sm" %>
          </div>
          <div class="space-y-2">
            <%= form.label 'Senha', class: "text-sm font-medium leading-none" %>
            <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: t('placeholders.user.password'), maxlength: 72, class: "flex h-10 w-full rounded-md border border-gray-300 bg-white px-3 py-2 mt-2 text-base placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-white disabled:cursor-not-allowed disabled:opacity-50 md:text-sm" %>
          </div>
          <%= form.submit t('buttons.general.enter'), class: "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-emerald-600 text-white hover:bg-emerald-700 shadow-md hover:shadow-lg transition duration-300 ease-in-out h-10 px-4 py-2 w-full" %>
          
          <div class="text-center flex flex-col">
            <%= link_to t('buttons.general.forgot_password'), new_password_path, class: "text-sm text-blue-600 hover:underline" %>
            <%= link_to 'Ainda não tenho conta?', sign_up_path, class: "text-sm text-blue-600 hover:underline" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

