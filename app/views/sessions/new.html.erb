<% content_for :title, "Elephanto | Iniciar sessão" %>

<turbo-frame id="flash">
  <%= render "shared/flash" %>
</turbo-frame>

<div class="min-h-screen flex overflow-hidden">
  <div
    class="
      hidden lg:flex lg:w-1/2 bg-gradient-third items-center justify-center p-8
      bg-gradient-primary
    "
  >
    <div class="text-center text-white">
      <h1 class="text-4xl font-bold mb-4">Bem-vindo(a) de volta ao Elephanto</h1>
      <p class="text-xl opacity-90">
        Aprenda com inteligência usando repetição espaçada
      </p>
      <div class="mt-8">
        <%= image_tag "logo_ligth.svg",
        class: "w-48 h-48 mx-auto filter brightness-0 invert" %>
      </div>
    </div>
  </div>
  <div class="flex-1 flex items-center justify-center p-8 bg-gray-100">
    <div
      class="
        rounded-lg border border-gray-300 bg-white text-gray-900 shadow-sm w-full
        max-w-md
      "
    >
      <div class="flex flex-col space-y-1.5 p-6 text-center">
        <div>
          <h3 class="text-2xl font-semibold leading-none tracking-tight"><%= t("general.signin") %></h3>
          <p class="text-sm text-gray-500 mt-2">Entre e aprenda um pouco mais ainda hoje</p>
        </div>
      </div>
      <div class="p-6 pt-0">
        <%= form_with url: session_url, class: "space-y-4" do |form| %>
          <div class="space-y-2">
            <%= form.label "Email", class: "ui-label" %>
            <%= form.email_field :email_address,
                             required: true,
                             autofocus: true,
                             autocomplete: "username",
                             placeholder: t("placeholders.user.email_address"),
                             value: params[:email_address],
                             class: "ui-input mt-2" %>
          </div>
          <div class="space-y-2" data-controller="password-visibility">
            <%= form.label "Senha", class: "ui-label" %>
            <div class="relative">
              <%= form.password_field :password,
                                  required: true,
                                  autocomplete: "current-password",
                                  placeholder: t("placeholders.user.password"),
                                  maxlength: 72,
                                  class: "ui-input mt-2",
                                  data: {
                                    "password-visibility-target": "input",
                                  } %>

              <button
                type="button"
                data-action="password-visibility#toggle"
                class="
                  text-gray-500 absolute inset-y-0 right-0 pr-3 flex items-center cursor-pointer
                "
              >
                <span data-password-visibility-target="icon">
                  <svg
                    data-password-visibility-target="icon"
                    xmlns="http://www.w3.org/2000/svg"
                    class="size-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                    ></path><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                    ></path></svg>
                </span>
                <span data-password-visibility-target="icon" class="hidden">
                  <svg
                    data-password-visibility-target="icon"
                    xmlns="http://www.w3.org/2000/svg"
                    class="size-6 hidden"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"
                    ></path></svg>
                </span>
              </button>
            </div>
          </div>
          <%= form.submit t("buttons.general.enter"),
                      class: "btn btn-default-variant btn-default-size w-full" %>

          <div class="text-center flex flex-col">
            <%= link_to t("buttons.general.forgot_password"),
            new_password_path,
            class: "text-sm text-blue-600 hover:underline" %>
            <%= link_to "Ainda não tenho conta?",
            sign_up_path,
            class: "text-sm text-blue-600 hover:underline" %>
            <%= link_to "Reenviar e-mail de confirmação",
            new_confirmation_path,
            class: "text-sm text-blue-600 hover:underline" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
