<%= form_with model: profile, data: { controller: "image-upload", image_upload_autosave_value: false }, class: "w-full" do |form| %>
  <div
    class="
      w-full h-48 sm:h-64 overflow-hidden relative group cursor-pointer bg-slate-100
      dark:bg-slate-800
    "
  >
    <label class="block w-full h-full cursor-pointer">
      <% if profile.persisted? && profile.cover_profile.attached? %>
        <%= image_tag profile.cover_profile,
        class: "w-full h-full object-cover",
        data: {
          image_upload_target: "preview",
        } %>
      <% else %>
        <img
          src="https://images.unsplash.com/photo-1557683316-973673baf926?q=80&w=1000"
          class="w-full h-full object-cover opacity-20 grayscale"
          data-image-upload-target="preview"
        />
      <% end %>

      <div
        class="
          absolute inset-0 flex items-center justify-center bg-slate-900/40 opacity-0
          group-hover:opacity-100 transition-all duration-300 backdrop-blur-sm
        "
      >
        <div
          class="
            flex items-center gap-2 bg-white/20 px-4 py-2 rounded-full border
            border-white/30 text-white font-black text-[10px] uppercase tracking-widest
          "
        >
          <span class="material-symbols-outlined text-sm">photo_camera</span>
          Trocar Capa
        </div>
      </div>

      <%= form.file_field :cover_profile,
                      class: "hidden",
                      accept: "image/*",
                      data: {
                        image_upload_target: "input",
                        action: "change->image-upload#previewImage",
                      } %>
    </label>
  </div>

  <div class="flex flex-col items-center -mt-16 sm:-mt-20 z-10 relative">
    <div class="relative group cursor-pointer">
      <label class="cursor-pointer block">
        <div
          class="
            size-32 sm:size-40 rounded-[2.5rem] border-[6px] border-white
            dark:border-slate-900 bg-slate-100 dark:bg-slate-800 shadow-2xl overflow-hidden
            relative
          "
        >
          <% if profile.persisted? && profile.avatar.attached? %>
            <%= image_tag profile.avatar,
            class: "w-full h-full object-cover",
            data: {
              image_upload_target: "preview",
            } %>
          <% else %>
            <div
              class="
                w-full h-full flex items-center justify-center bg-slate-50 dark:bg-slate-950
              "
              data-image-upload-target="preview"
            >
              <span class="material-symbols-outlined text-4xl text-[#60c2a6]">person</span>
            </div>
          <% end %>

          <div
            class="
              absolute inset-0 bg-slate-900/60 opacity-0 group-hover:opacity-100
              transition-all duration-300 flex items-center justify-center text-white
            "
          >
            <span class="material-symbols-outlined">add_a_photo</span>
          </div>
        </div>
        <%= form.file_field :avatar,
                        class: "hidden",
                        accept: "image/*",
                        data: {
                          image_upload_target: "input",
                          action: "change->image-upload#previewImage",
                        } %>
      </label>
    </div>
  </div>

  <div class="p-8 sm:p-12 space-y-8">
    <%# Nome e Sobrenome na mesma linha %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="space-y-2">
        <%= form.label :first_name,
                   class:
                     "form-label" %>
        <div class="relative group">
          <span
            class="
              material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2
              text-slate-400 group-focus-within:text-[#60c2a6] transition-colors
            "
          >badge</span>
          <%= form.text_field :first_name,
                          placeholder: "Ex: Cleyton",
                          class:
                            "form-input #{error_class(profile, :first_name)}" %>
        </div>
        <% if profile.errors[:first_name].any? %>
            <p class="text-xs font-bold text-red-500 ml-1 mt-1 flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">error</span>
              <%= profile.errors[:first_name].first %>
            </p>
        <% end %>
      </div>

      <div class="space-y-2">
        <%= form.label :last_name,
                   class:
                     "form-label" %>
        <div class="relative group">
          <span
            class="
              material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2
              text-slate-400 group-focus-within:text-[#60c2a6] transition-colors
            "
          >subtitles</span>
          <%= form.text_field :last_name,
                          placeholder: "Ex: Silva",
                          class:
                            "form-input #{error_class(profile, :last_name)}" %>
        </div>
        <% if profile.errors[:last_name].any? %>
            <p class="text-xs font-bold text-red-500 ml-1 mt-1 flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">error</span>
              <%= profile.errors[:last_name].first %>
            </p>
        <% end %>
      </div>
    </div>

    <div class="space-y-2">
      <%= form.label :username,
                 class:
                   "form-label" %>
      <div class="relative group">
        <span
          class="
            material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2
            text-slate-400 group-focus-within:text-[#60c2a6] transition-colors
          "
        >alternate_email</span>
        <%= form.text_field :username,
                        placeholder: "seu_nome",
                        class:
                          "form-input #{error_class(profile, :username)}" %>
      </div>
      <% if profile.errors[:username].any? %>
          <p class="text-xs font-bold text-red-500 ml-1 mt-1 flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">error</span>
            <%= profile.errors[:username].first %>
          </p>
      <% end %>
    </div>

    <div
      class="space-y-2"
      data-controller="location-autocomplete"
      data-mapbox-key="<%= ENV.fetch("MAPBOX_PUBLIC_KEY") %>"
    >
      <%= form.label :location,
                 "Localização",
                 class:
                   "form-label" %>
      <div class="relative group">
        <span
          class="
            material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2
            text-slate-400 group-focus-within:text-[#60c2a6] transition-colors
          "
        >location_on</span>
        <%= form.text_field :location,
                        placeholder: "Qual cidade você mora?",
                        data: {
                          location_autocomplete_target: "input",
                          action:
                            "input->location-autocomplete#search keydown->location-autocomplete#keydown",
                        },
                        class:
                          "form-input #{error_class(profile, :location)}" %>
        <%= form.hidden_field :location_country,
                          data: {
                            location_autocomplete_target: "country",
                          } %>
        <ul
          data-location-autocomplete-target="results"
          class="
            absolute w-full bg-white dark:bg-slate-800 border border-slate-100
            dark:border-slate-700 rounded-2xl mt-2 shadow-2xl hidden z-50 overflow-hidden
            font-bold text-sm text-slate-600 dark:text-slate-300
          "
        ></ul>
      </div>
      <% if profile.errors[:location].any? %>
          <p class="text-xs font-bold text-red-500 ml-1 mt-1 flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">error</span>
            <%= profile.errors[:location].first %>
          </p>
      <% end %>
    </div>

    <div class="space-y-2">
      <%= form.label :bio,
                 class:
                   "form-label" %>
      <div class="relative group">
        <span
          class="
            material-symbols-outlined absolute left-4 top-4 text-slate-400
            group-focus-within:text-[#60c2a6] transition-colors
          "
        >notes</span>
        <%= form.text_area :bio,
                       rows: 4,
                       placeholder: "Conte um pouco sobre seus objetivos de estudo...",
                       class:
                         "form-textarea #{error_class(profile, :bio)}" %>
      </div>
      <% if profile.errors[:bio].any? %>
          <p class="text-xs font-bold text-red-500 ml-1 mt-1 flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">error</span>
            <%= profile.errors[:bio].first %>
          </p>
      <% end %>
    </div>

    <div class="pt-6">
      <%= form.submit "Salvar Alterações",
                  class:
                    "w-full h-14 bg-slate-900 dark:bg-[#60c2a6] text-white dark:text-slate-900 rounded-2xl font-black uppercase tracking-widest text-xs hover:scale-[1.01] active:scale-[0.99] transition-all shadow-xl shadow-slate-200 dark:shadow-emerald-900/20 cursor-pointer" %>
    </div>
  </div>
<% end %>
