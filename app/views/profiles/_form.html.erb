<%= simple_form_for @profile, class: "contents" do |form| %>
	<div class="px-4 py3">
		<div data-controller="dropzone" data-dropzone-target="dropArea">
			<div
				data-dropzone-target="dropArea"
				class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center cursor-pointer"
			>
				<p class="text-gray-600"><%= t('general.drag_and_drop') %></p>
				<%= form.file_field :avatar, class: "hidden", data: { dropzone_target: "input" } %>
				<img data-dropzone-target="preview" class="hidden mx-auto mt-4 max-h-32 rounded-full" />
			</div>
		</div>
	</div>

	<div class="px-4 py-3">
		<%= form.input :first_name, input_html: { class: ["bg-[#f0f2f4] shadow-sm rounded-xl border px-3 py-2 mt-2 w-full",
																											{"border-none focus:outline-blue-600": profile.errors[:first_name].none?,
																											"border-red-400 focus:outline-red-600": profile.errors[:first_name].any?}] 
																						}, placeholder: t('placeholders.profile.first_name') %>
	</div>

	<div class="px-4 py-3">
		<%= form.input :last_name, input_html: { class: ["bg-[#f0f2f4] shadow-sm rounded-xl border px-3 py-2 mt-2 w-full",
																									{"border-none focus:outline-blue-600": profile.errors[:last_name].none?,
																									"border-red-400 focus:outline-red-600": profile.errors[:last_name].any?}] 
																						}, placeholder: t('placeholders.profile.last_name') %>
	</div>

	<div class="px-4 py-3">
		<%= form.input :username, input_html: { class: ["bg-[#f0f2f4] shadow-sm rounded-xl border px-3 py-2 mt-2 w-full",
																											{"border-none focus:outline-blue-600": profile.errors[:username].none?,
																											"border-red-400 focus:outline-red-600": profile.errors[:username].any?}] 
																					}, placeholder: t('placeholders.profile.username') %>
	</div>

	<div class="px-4 py-3">
		<%= form.input :bio, as: "text", input_html: { class: ["bg-[#f0f2f4] shadow-sm rounded-xl border px-3 py-2 mt-2 w-full", 
																													{"border-none focus:outline-blue-600": profile.errors[:bio].none?, 
																															"border-red-400 focus:outline-red-600": profile.errors[:bio].any?}],
																															"rows": 5
																									}, placeholder: t('placeholders.profile.bio') %>
	</div>

  <div class="flex px-4 py-3 space-x-3">
    <%= form.submit class: "cursor-pointer overflow-hidden rounded-full h-10 px-4 bg-[#1978e5] text-white text-sm font-bold leading-normal tracking-[0.015em]" %>
  </div>
<% end %>


          