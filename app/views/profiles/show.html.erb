<% content_for :title, "#{t('actions.showing')} #{Profile.model_name.human.downcase}" %>

<turbo-frame id="flash">
  <%= render "shared/flash" %>
</turbo-frame>

<div class="min-h-screen bg-background">
  <% right_buttons = capture do %>
  <div class="flex gap-2 w-full">
    <%= link_to edit_profile_path(@profile), class: "btn btn-default-size btn-default-variant w-full" do %>
    <%= t('buttons.submit.edit_profile') %>
    <% end %>
  </div>
  <% end %>

  <%= page_header(
    show_back_button: true,
		back_path: decks_path,
    title: t('general.my_profile'),
    subtitle: t('general.menage_account'),
    show_profile_menu: false,
		right_buttons: right_buttons
  ) %>

  <main data-controller="automatic-margin-top" class="container max-w-2xl mx-auto p-6">
    <div class="rounded-lg border border-[#DCDFE5] bg-white text-[#21242C]">
      <div class="flex flex-col space-y-1.5 p-6 text-center pb-2">
        <div class="flex flex-col items-center space-y-4">
          <% if @profile.avatar.attached? %>
          <img src="<%= url_for(@profile.avatar) %>" class="mx-auto mt-4 max-h-32 rounded-full" />
          <% else %>
          <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full min-h-32 w-32">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
              <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
              <g id="SVGRepo_iconCarrier">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M16 9C16 11.2091 14.2091 13 12 13C9.79086 13 8 11.2091 8 9C8 6.79086 9.79086 5 12 5C14.2091 5 16 6.79086 16 9ZM14 9C14 10.1046 13.1046 11 12 11C10.8954 11 10 10.1046 10 9C10 7.89543 10.8954 7 12 7C13.1046 7 14 7.89543 14 9Z" fill="#000000"></path>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 1C5.92487 1 1 5.92487 1 12C1 18.0751 5.92487 23 12 23C18.0751 23 23 18.0751 23 12C23 5.92487 18.0751 1 12 1ZM3 12C3 14.0902 3.71255 16.014 4.90798 17.5417C6.55245 15.3889 9.14627 14 12.0645 14C14.9448 14 17.5092 15.3531 19.1565 17.4583C20.313 15.9443 21 14.0524 21 12C21 7.02944 16.9706 3 12 3C7.02944 3 3 7.02944 3 12ZM12 21C9.84977 21 7.87565 20.2459 6.32767 18.9878C7.59352 17.1812 9.69106 16 12.0645 16C14.4084 16 16.4833 17.1521 17.7538 18.9209C16.1939 20.2191 14.1881 21 12 21Z" fill="#000000"></path>
              </g>
            </svg>
          </div>
          <% end %>
          <div class="space-y-1">
            <h3 class="font-semibold tracking-tight text-2xl"><%= @profile.first_name%> <%= @profile.last_name%></h3>
            <p class="text-[#676F7E] text-base">@<%= @profile.username %></p>
          </div>
        </div>
      </div>
      <div class="p-6 pt-0 space-y-6">
        <div class="text-center">
          <p class="text-[#676F7E] leading-relaxed"><%= @profile.bio %></p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex items-center gap-3 p-3 rounded-lg bg-[#676F7E]/10">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-icon lucide-user text-[#676F7E] w-5 h-5">
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" /></svg>
            <div>
              <p class="text-sm text-[#676F7E]">Nome completo</p>
              <p class="font-medium"><%= @profile.first_name%> <%= @profile.last_name%></p>
            </div>
          </div>
          <div class="flex items-center gap-3 p-3 rounded-lg bg-[#676F7E]/10">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-icon lucide-calendar text-[#676F7E] w-5 h-5">
              <path d="M8 2v4" />
              <path d="M16 2v4" />
              <rect width="18" height="18" x="3" y="4" rx="2" />
              <path d="M3 10h18" /></svg>
            <div>
              <p class="text-sm text-[#676F7E]">Membro desde</p>
              <p class="font-medium"><%= l @profile.created_at, format: :only_date %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>