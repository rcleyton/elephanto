<% content_for :title, "Meu Perfil • Elephanto" %>

<turbo-frame id="flash">
  <%= render "shared/flash" %>
</turbo-frame>

<main class="flex flex-1 justify-center py-12 px-4 sm:px-6">
  <div class="max-w-[850px] flex-1">

    <%= render "shared/page_header",
    eyebrow: "Perfil do usuário",
    title: "Perfil",
    description: "Gerencie sua identidade no Elephanto." %>

    <div
      class="
        overflow-hidden rounded-[2.5rem] border border-slate-100 dark:border-slate-800
        bg-white dark:bg-slate-900 shadow-2xl shadow-slate-200/50 dark:shadow-none
      "
    >

      <%# Seção da Capa (Form 1) %>
      <%= form_with model: @profile, url: profile_path(@profile), method: :patch, multipart: true, data: { controller: "image-upload", image_upload_autosave_value: true }, class: "w-full" do |f| %>
        <div
          class="
            w-full h-56 sm:h-72 overflow-hidden relative group cursor-pointer bg-slate-100
            dark:bg-slate-800
          "
        >
          <label class="block w-full h-full cursor-pointer">
            <% if @profile.cover_profile.attached? %>
              <%= image_tag @profile.cover_profile,
              class:
                "w-full h-full object-cover transition-transform duration-700 group-hover:scale-105",
              data: {
                image_upload_target: "preview",
              } %>
            <% else %>
              <div
                class="
                  w-full h-full bg-gradient-to-br from-slate-200 to-slate-300 dark:from-slate-800
                  dark:to-slate-900 flex items-center justify-center
                "
              >
                <span class="material-symbols-outlined text-slate-400 text-4xl">landscape</span>
              </div>
            <% end %>

            <div
              class="
                absolute inset-0 bg-slate-900/40 opacity-0 group-hover:opacity-100
                transition-all duration-300 flex items-center justify-center backdrop-blur-sm
              "
            >
              <div
                class="
                  flex items-center gap-2 bg-white/20 px-4 py-2 rounded-full border
                  border-white/30 text-white font-bold text-sm
                "
              >
                <span class="material-symbols-outlined text-sm">photo_camera</span>
                Alterar capa
              </div>
            </div>

            <%= f.file_field :cover_profile,
                         hidden: true,
                         accept: "image/*",
                         data: {
                           image_upload_target: "input",
                           action: "change->image-upload#previewImage",
                         } %>
          </label>
        </div>
      <% end %>

      <%# Seção de Info e Avatar (Form 2) %>
      <div class="relative px-8 pb-8">

        <div class="flex flex-col items-center -mt-20 gap-6">
          <%= form_with model: @profile, url: profile_path(@profile), method: :patch, multipart: true, data: { controller: "image-upload", image_upload_autosave_value: true } do |f| %>
            <div class="relative group cursor-pointer">
              <label class="cursor-pointer block">
                <div
                  class="
                    size-40 rounded-[2.5rem] border-[6px] border-white dark:border-slate-900
                    bg-slate-100 dark:bg-slate-800 shadow-2xl overflow-hidden relative
                  "
                >
                  <% if @profile.avatar.attached? %>
                    <%= image_tag @profile.avatar,
                    class: "w-full h-full object-cover",
                    data: {
                      image_upload_target: "preview",
                    } %>
                  <% else %>
                    <div
                      class="w-full h-full flex items-center justify-center"
                      data-image-upload-target="preview"
                    >
                      <span class="material-symbols-outlined text-5xl text-slate-300">account_circle</span>
                    </div>
                  <% end %>

                  <div
                    class="
                      absolute inset-0 bg-slate-900/60 opacity-0 group-hover:opacity-100
                      transition-all duration-300 flex items-center justify-center
                    "
                  >
                    <span class="material-symbols-outlined text-white text-2xl">edit</span>
                  </div>
                </div>

                <%= f.file_field :avatar,
                             hidden: true,
                             accept: "image/*",
                             data: {
                               image_upload_target: "input",
                               action: "change->image-upload#previewImage",
                             } %>
              </label>
            </div>
          <% end %>

          <%# Informações de Texto %>
          <div class="text-center space-y-2">
            <h2 class="text-3xl font-black text-slate-900 dark:text-white tracking-tight">
              <%= @profile.first_name %>
              <%= @profile.last_name %>
            </h2>
            <div class="flex flex-wrap items-center justify-center gap-3">
              <span
                class="
                  px-3 py-1 rounded-full bg-[#60c2a6]/10 text-[#60c2a6] text-xs font-black
                  uppercase tracking-widest
                "
              >
                @<%= @profile.username %>
              </span>
              <% if @profile.location.present? %>
                <div
                  class="
                    flex items-center gap-1 text-slate-400 dark:text-slate-500 text-xs font-bold
                    uppercase tracking-widest
                  "
                >
                  <span class="material-symbols-outlined text-sm">location_on</span>
                  <%= @profile.location %>,
                  <%= @profile.location_country %>
                </div>
              <% end %>
            </div>
          </div>

          <%# Ações Principais %>
          <div class="flex gap-4 w-full max-w-sm pt-2">
            <%= link_to edit_profile_path(@profile), class: "flex-1 flex items-center justify-center gap-3 h-14 bg-slate-900 dark:bg-[#60c2a6] text-white dark:text-slate-900 rounded-2xl font-black uppercase tracking-widest text-xs hover:scale-[1.02] active:scale-[0.98] transition-all shadow-xl shadow-slate-200 dark:shadow-emerald-900/20" do %>
              <span class="material-symbols-outlined text-lg">edit_note</span>
              Editar Perfil
            <% end %>
          </div>
        </div>

        <%# Bio Section %>
        <div class="mt-12 w-full">
          <div
            class="
              flex flex-col gap-4 p-8 rounded-[2rem] bg-slate-50 dark:bg-slate-950/50 border
              border-slate-100 dark:border-slate-800/50
            "
          >
            <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-[0.3em]">Sobre Mim</h3>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed font-medium">
              <%= @profile.bio.present? ? @profile.bio : "Nenhuma biografia adicionada ainda..." %>
            </p>
          </div>
        </div>

        <%# Logout Section %>
        <div class="mt-8 pt-8 border-t border-slate-100 dark:border-slate-800">
          <%= link_to session_path, data: { turbo_method: :delete }, class: "w-full flex items-center justify-center gap-3 h-14 rounded-2xl border-2 border-rose-100 dark:border-rose-900/30 text-rose-500 font-black uppercase tracking-widest text-[10px] hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-all" do %>
            <span class="material-symbols-outlined text-lg">logout</span>
            Encerrar Sessão
          <% end %>
        </div>

      </div>
    </div>
  </div>
</main>
