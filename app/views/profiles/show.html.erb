<% content_for :title, "#{t('actions.showing')} #{Profile.model_name.human.downcase}" %>

<div class="layout-content-container flex flex-col max-w-[960px] flex-1">
	<div class="flex flex-wrap justify-between gap-3 p-4">
		<div class="flex min-w-72 flex-col gap-3">
			<p class="text-[#111418] tracking-light text-[32px] font-bold leading-tight"><%= t('general.my_profile')%></p>
			<p class="text-[#637488] text-sm font-normal leading-normal"><%= t('general.menage_account')%></p>
		</div>
	</div>
	<div class="flex p-4 @container">
		<div class="flex w-full flex-col gap-4 @[520px]:flex-row @[520px]:justify-between @[520px]:items-center">
			<div class="flex gap-4">
				<div
					class="bg-center bg-no-repeat aspect-square bg-cover rounded-full min-h-32 w-32"
					style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuB5iopFRs_mHHWb4daesZUh8OuRnFXVriq1450xzu9mbsVbYMvgOqjIisPBoaeHPmdOPJP4Fs1kQCG2CBTQsud0xiC4cEypngypkEqKOl6k51Ogb2IHYo5NUx4W6OZX4arcWP8vIbONAeisKXcNfT5RK6XbDi1yLhflRfT9uKWNadyjYGq50n-41YJWihk98flwiWA6EuH8fmC5BOW2LN-kRgOT2SOsOYtm3lAlsSVd2X4L-EYqsBkQE8taA3rK_1izkv7kELNKwgdr");'
				></div>
				<div class="flex flex-col justify-center">
					<p class="text-[#111418] text-[22px] font-bold leading-tight tracking-[-0.015em]"><%= @profile.first_name%> <%= @profile.last_name%></p>
					<p class="text-[#637488] text-base font-normal leading-normal"><%= current_user.email_address %></p>
				</div>
			</div>
			<%= link_to edit_profile_path(@profile), class: "flex min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 px-4 bg-[#f0f2f4] text-[#111418] text-sm font-bold leading-normal tracking-[0.015em] w-full max-w-[480px] @[480px]:w-auto" do %>
				<span class="truncate"><%= t('buttons.submit.edit_profile') %></span>
			<% end %>
		</div>
	</div>
	<h2 class="text-[#111418] text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5"><%= t('general.statistics') %></h2>
	<div class="flex flex-wrap gap-3 px-4 py-3">
		<div class="flex min-w-[111px] flex-1 basis-[fit-content] flex-col gap-2 rounded-lg border border-[#dce0e5] p-3 items-start">
			<p class="text-[#111418] tracking-light text-2xl font-bold leading-tight"><%= current_user.decks.size %></p>
			<div class="flex items-center gap-2"><p class="text-[#637488] text-sm font-normal leading-normal"><%= t('general.decks_created') %></p></div>
		</div>
		<div class="flex min-w-[111px] flex-1 basis-[fit-content] flex-col gap-2 rounded-lg border border-[#dce0e5] p-3 items-start">
			<p class="text-[#111418] tracking-light text-2xl font-bold leading-tight">
				<%= flashcards_studied(current_user) %>
			</p>
			<div class="flex items-center gap-2"><p class="text-[#637488] text-sm font-normal leading-normal"><%= t('general.flashcard_studied')%></p></div>
		</div>
	</div>
	<h2 class="text-[#111418] text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5"><%= t('general.settings') %></h2>
	<div class="flex items-center gap-4 bg-white px-4 min-h-[72px] py-2 justify-between">
		<div class="flex flex-col justify-center">
			<p class="text-[#111418] text-base font-medium leading-normal line-clamp-1"><%= t('general.change_password') %></p>
			<p class="text-[#637488] text-sm font-normal leading-normal line-clamp-2"><%= t('general.update_password') %></p>
		</div>
		<div class="shrink-0">
			<div class="text-[#111418] flex size-7 items-center justify-center" data-icon="CaretRight" data-size="24px" data-weight="regular">
				<svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" fill="currentColor" viewBox="0 0 256 256">
					<path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"></path>
				</svg>
			</div>
		</div>
	</div>
	<div class="flex px-4 py-3 justify-start">
		<%= link_to session_path, data: { turbo_method: :delete, turbo_confirm: t('general.are_you_sure') }, class: "flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 px-4 bg-[#f0f2f4] text-[#111418] text-sm font-bold leading-normal tracking-[0.015em]" do %>
			<span class="truncate"><%= t('buttons.general.logout')%></span>
		<% end %>
	</div>
</div>