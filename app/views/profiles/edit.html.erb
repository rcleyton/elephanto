<% content_for :title, "#{t('actions.edit')} #{Profile.model_name.human.downcase}" %>

<turbo-frame id="flash">
  <%= render "shared/flash" %>
</turbo-frame>

<div class="min-h-screen bg-background">
  <%= page_header(
    show_back_button: true,
		back_path: profile_path(@profile),
    title: "#{t('actions.edit')} #{Profile.model_name.human.downcase}",
    subtitle: "Edite seu perfil para gerenciar seus flashcards",
    show_profile_menu: false,
  ) %>

  <main data-controller="automatic-margin-top" class="container max-w-2xl mx-auto px-6 py-8">
    <div class="rounded-lg border border-[#DCDFE5] bg-white text-[#21242C]">
      <%= render "form", profile: @profile %>
    </div>
  </main>
</div>
