<header
  class="
    sticky top-0 z-50 w-full border-b border-slate-200/60 dark:border-slate-800/60
    bg-white/70 dark:bg-slate-950/70 backdrop-blur-xl
  "
  data-controller="header mobile-menu"
>
  <div
    class="
      mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8 h-20
    "
  >

    <%# Logo Section %>
    <%= link_to decks_path, class: "group transition-transform active:scale-95" do %>
      <div class="flex items-center gap-3">
        <div
          class="
            flex h-11 w-11 items-center justify-center rounded-xl bg-slate-900
            dark:bg-[#60c2a6] shadow-lg shadow-slate-200 dark:shadow-emerald-900/20
            group-hover:rotate-3 transition-transform
          "
        >
          <%= image_tag "logo_ligth.svg", class: "w-7 h-7 dark:invert-0" %>
        </div>
        <h2 class="text-2xl font-black tracking-tighter text-slate-900 dark:text-white">Elephanto</h2>
      </div>
    <% end %>

    <%# Search Bar - Desktop %>
    <div class="hidden md:flex flex-1 max-w-md mx-12">
      <div class="relative w-full group">
        <div
          class="
            pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4
            text-slate-400 group-focus-within:text-[#60c2a6] transition-colors
          "
        >
          <span class="material-symbols-outlined text-xl">search</span>
        </div>
        <input
          class="
            block w-full rounded-2xl border-0 bg-slate-100 dark:bg-slate-900/50 py-3 pl-12
            pr-4 text-sm font-medium placeholder:text-slate-400 focus:ring-2
            focus:ring-[#60c2a6]/30 focus:bg-white dark:focus:bg-slate-900 transition-all
            outline-none
          "
          placeholder="Buscar decks ou tópicos..."
          type="text"
        />
      </div>
    </div>

    <%# Right Side Actions %>
    <div class="flex items-center gap-2 sm:gap-6">

      <%# Notificações %>
      <button
        class="
          relative flex rounded-xl p-2.5 text-slate-500 hover:bg-slate-100
          dark:text-slate-400 dark:hover:bg-slate-800 transition-all
        "
      >
        <span class="material-symbols-outlined">notifications</span>
        <span
          class="
            absolute top-2.5 right-2.5 h-2 w-2 rounded-full bg-[#60c2a6] border-2
            border-white dark:border-slate-950
          "
        ></span>
      </button>

      <div class="hidden sm:block h-8 w-px bg-slate-200 dark:bg-slate-800"></div>

      <%# Profile Dropdown Container %>
      <div class="relative">
        <div
          class="flex items-center gap-4 cursor-pointer group"
          data-action="click->header#toggleProfileDropdown"
        >

          <div class="text-right hidden lg:block">
            <p
              class="
                text-xs font-black text-slate-900 dark:text-slate-100 uppercase tracking-tighter
              "
            >
              <%= if current_user.profile&.persisted?
                current_user.profile.first_name
              else
                current_user.email_address.split("@").first
              end %>
            </p>
            <p
              class="
                text-[10px] font-bold text-[#60c2a6] uppercase tracking-widest leading-none
                mt-0.5
              "
            >Premium Plan</p>
          </div>

          <%# Avatar %>
          <div
            class="
              h-11 w-11 rounded-2xl border-2 border-white dark:border-slate-800 bg-slate-100
              dark:bg-slate-800 flex items-center justify-center overflow-hidden shadow-sm
              group-hover:border-[#60c2a6] transition-all
            "
          >
            <% profile = current_user.profile %>
            <% if profile&.persisted? && profile.avatar.attached? %>
              <%= image_tag profile.avatar, class: "w-full h-full object-cover" %>
            <% else %>
              <span class="material-symbols-outlined text-slate-400 dark:text-slate-500">account_circle</span>
            <% end %>
          </div>

          <%# Dropdown Menu %>
          <div
            data-header-target="profileDropdownMenu"
            class="
              absolute right-0 top-[calc(100%+1rem)] w-60 bg-white dark:bg-slate-900
              backdrop-blur-xl border border-slate-100 dark:border-slate-800 rounded-[2rem]
              shadow-2xl z-50 overflow-hidden hidden
            "
          >
            <%# Dropdown Header %>
            <div
              class="
                px-6 py-5 bg-slate-50/50 dark:bg-slate-800/50 border-b border-slate-100
                dark:border-slate-800
              "
            >
              <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">Minha Conta</p>
              <p class="text-sm font-bold text-slate-900 dark:text-white truncate">
                <%= current_user.email_address %>
              </p>
            </div>

            <%# Dropdown Links %>
            <div class="p-2">
              <%= link_to path_to_profile, class: "flex items-center gap-3 rounded-2xl px-4 py-3 text-slate-600 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-800 hover:text-[#60c2a6] transition-all text-sm font-bold group/item" do %>
                <span
                  class="
                    material-symbols-outlined text-slate-400 group-hover/item:text-[#60c2a6]
                  "
                >person</span>
                Meu Perfil
              <% end %>

              <%= link_to statistics_path, class: "flex items-center gap-3 rounded-2xl px-4 py-3 text-slate-600 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-800 hover:text-[#60c2a6] transition-all text-sm font-bold group/item" do %>
                <span
                  class="
                    material-symbols-outlined text-slate-400 group-hover/item:text-[#60c2a6]
                  "
                >leaderboard</span>
                Estatísticas
              <% end %>
              <%= link_to settings_path, class: "flex items-center gap-3 rounded-2xl px-4 py-3 text-slate-600 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-800 hover:text-[#60c2a6] transition-all text-sm font-bold group/item" do %>
                <span
                  class="
                    material-symbols-outlined text-slate-400 group-hover/item:text-[#60c2a6]
                  "
                >settings</span>
                Configurações
              <% end %>
              <% if current_user.admin? %>
                <div class="h-px bg-slate-100 dark:bg-slate-800 my-2 mx-4"></div>
                <%= link_to admin_path, class: "flex items-center gap-3 rounded-2xl px-4 py-3 text-slate-600 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-800 hover:text-[#60c2a6] transition-all text-sm font-bold group/item" do %>
                  <span
                    class="
                      material-symbols-outlined text-slate-400 group-hover/item:text-[#60c2a6]
                    "
                  >dashboard</span>
                  Painel Admin
                <% end %>
              <% end %>
            </div>

            <%# Dropdown Footer %>
            <div class="p-2 border-t border-slate-100 dark:border-slate-800">
              <%= button_to session_path, method: :delete, class: "w-full flex items-center gap-3 rounded-2xl px-4 py-3 text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition-all text-sm font-bold cursor-pointer" do %>
                <span class="material-symbols-outlined">logout</span>
                Sair do Elephanto
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
