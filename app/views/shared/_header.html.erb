<header class="fixed top-0 right-0 left-0 md:static border-b border-gray-200 bg-gray-50/80 backdrop-blur-lg" data-controller="header">
  <div class="container mx-auto px-6 py-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">  
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-4">
          <% if show_back_button %>
            <%= link_to back_path, class: "icon-arrow-left inline-flex items-center justify-center rounded-md ring-offset-white transition duration-300 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0  hover:bg-[#8C5AF2] hover:text-white h-10 w-10" do %>
              <%= image_tag "arrow-left.svg", class: "h-4 w-4" %>            
            <% end %>
          <% end %>
          <div>
            <h1 class="text-3xl font-bold bg-primary bg-clip-text text-transparent">
              <%= title %> 
            </h1>
            <% if subtitle %>
              <p class="text-[#676F7E] text-muted-foreground mt-2">
                <%= subtitle %>
              </p>
            <% end %>
          </div>
        </div>
        <% if show_profile_menu %>
          <div class="md:hidden">
            <button data-action="header#toggleMobileMenu" class="text-gray-900 p-2 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="Abrir menu">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-settings w-6 h-6">
                <path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"/>
                  <circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
        <% end %> 
      </div>
      <div class="flex items-center gap-4 md:gap-8">
        <% if show_new_deck_button %>
          <%= link_to new_deck_path, class: "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 bg-accent text-accent-foreground hover:bg-accent/90 shadow-elegant hover:shadow-glow transition-smooth font-semibold h-10 px-4 py-2 gap-2 w-full" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-plus w-4 h-4">
              <path d="M5 12h14"/>
              <path d="M12 5v14"/>
            </svg>
            <%= t('buttons.submit.new_deck') %>
          <% end %>   
        <% end %>
          
        <% if show_profile_menu %>
          <%= render 'shared/profile_menu' %>
        <% end %>

        <% if right_buttons %>
          <%= right_buttons %>
        <% end %>
      </div>
    </div>
  </div>
  <% if show_profile_menu %>
    <%= render 'shared/mobile_menu' %>
  <% end %>
  
  <% progress = flashcard_progress(@deck) %>

  <% if controller_name == "flashcards" && controller.action_name == "show" %>
    <div class="w-full bg-gray-200 h-2.5 dark:bg-gray-700">
      <div class="bg-blue-600 h-2.5" style="width: <%= progress[:percent] %>%"></div>
    </div> 
  <% end %>
</header>


