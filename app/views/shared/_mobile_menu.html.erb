  <div data-header-target="overlay"
    data-action="click->header#closeMobileMenu"
    class="h-screen fixed inset-0 bg-black/50 hidden z-40 md:hidden">
  </div>
  <div data-header-target="mobileMenu"
    class="h-screen fixed inset-y-0 right-0 w-64 bg-white shadow-xl border-l border-gray-200 transform translate-x-full transition-transform duration-300 ease-in-out z-50 md:hidden rounded-md">
    <h2 class="text-xl font-bold text-gray-800 p-6 border-b-1">Menu
      <span class="text-xs leading-none text-muted-foreground block"><%= current_user.email_address %></span>
    </h2>
    
    <ul class="mt-2 space-y-2 px-4">
      <li class="flex items-center space-x-4 p-3 text-muted-foreground hover:text-white hover:bg-accent rounded-md transition-colors duration-200">
        <div class="p-2 bg-gray-100 rounded-full text-gray-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-icon lucide-user"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <%= link_to 'Meu perfil', path_to_profile, class: "text-sm font-semibold" %>
      </li>
      <li class="flex items-center space-x-4 p-3 text-muted-foreground hover:text-white hover:bg-accent rounded-md transition-colors duration-200">
        <div class="p-2 bg-gray-100 rounded-full text-gray-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chart-spline-icon lucide-chart-spline">
            <path d="M3 3v16a2 2 0 0 0 2 2h16"/>
            <path d="M7 16c.5-2 1.5-7 4-7 2 0 2 3 4 3 2.5 0 4.5-5 5-7"/>
          </svg>
        </div>
        <%= link_to 'Estatísticas', statistics_path, class: "text-sm font-semibold" %>
      </li>
      <li class="flex items-center space-x-4 p-3 text-muted-foreground hover:text-white hover:bg-accent rounded-md transition-colors duration-200">
        <div class="p-2 bg-gray-100 rounded-full text-gray-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings">
            <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </div>
        <%= link_to 'Configurações', settings_path, class: "text-sm font-semibold" %>
      </li>
      <li class="flex items-center space-x-4 p-3 text-muted-foreground hover:text-white hover:bg-accent rounded-md transition-colors duration-200">
        <div class="p-2 bg-gray-100 rounded-full text-gray-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-log-out-icon lucide-log-out"><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/></svg>
        </div>
        <%= link_to "Sair", session_path, data: { turbo_method: :delete }, class: "text-sm font-semibold" %>
      </li>
    </ul>
  </div>
