<div
  class="mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between"
>
  <div class="flex flex-col gap-2">

    <% if eyebrow.present? %>
      <div class="flex items-center gap-3 mb-1">
        <div class="h-1 w-8 bg-[#60c2a6] rounded-full"></div>

        <span class="text-[10px] font-black uppercase tracking-[0.3em] text-[#60c2a6]">
          <%= eyebrow %>
        </span>
      </div>
    <% end %>

    <h1
      class="
        text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-4xl
      "
    >
      <%= title %>
    </h1>

    <% if description.present? %>
      <p class="mt-2 text-base text-slate-600 dark:text-slate-400">
        <%= description %>
      </p>
    <% end %>

  </div>

  <% if content_for?(:page_header_actions) %>
    <div class=" flex flex-col gap-3 md:flex-row md:items-center w-full md:w-auto ">
      <%= yield :page_header_actions %>
    </div>
  <% end %>
</div>
