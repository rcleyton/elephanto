<% flash.each do |type, message| %>
  <div
    data-controller="notification"
    data-notification-delay-value="5000"
    class="
      fixed flex justify-between
      bottom-4 left-1/2 -translate-x-1/2
      w-[calc(100%-2rem)]
      sm:w-auto sm:right-4 sm:left-auto sm:translate-x-0
      <%= flash_class_for(type) %>
      p-4 rounded-sm transition transform duration-1000 hidden z-50
    "
    data-transition-enter-from="opacity-0 translate-y-4 sm:translate-x-6"
    data-transition-enter-to="opacity-100 translate-y-0 sm:translate-x-0"
    data-transition-leave-from="opacity-100 translate-y-0 sm:translate-x-0"
    data-transition-leave-to="opacity-0 translate-y-4 sm:translate-x-6"
    data-flash-target="message"
  >
    <p class="text-sm opacity-90"><%= message %></p>
    <button
      data-action="notification#hide"
      class="ml-2 flex items-center justify-center"
    >
      <svg
        class="w-3 h-3 sm:w-4 sm:h-4 <%= type == 'alert' ? 'text-gray-900 hover:text-gray-700' : 'text-white hover:text-gray-200' %>"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        ></path>
      </svg>
    </button>
  </div>
<% end %>
