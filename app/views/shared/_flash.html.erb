<% flash.each do |type, message| %>
  <div class="border-l-4 p-4 m-3 rounded shadow-sm <%= flash_class_for(type) %> relative"
       data-controller="flash"
       data-flash-target="message">

    <p class="block sm:inline mr-8"><%= message %></p>

    <button type="button"
            class="absolute top-0 bottom-0 right-0 px-4 py-3 text-current hover:text-opacity-75 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-current"
            data-action="flash#close">
      <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
<% end %>
