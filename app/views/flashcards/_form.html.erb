<%= form_with model: [ @deck, @flashcard ], class: "space-y-6" do |form| %>
  <div class="space-y-2">
    <%= form.label :front, class: "text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" %>
    <%= form.text_field :front, placeholder: t("placeholders.flashcard.front_flashcard"), class: ["flex h-10 w-full rounded-md border border-gray-300 bg-[#F9FAFB] px-3 py-2 mt-2 text-base placeholder:text-gray-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-white disabled:cursor-not-allowed disabled:opacity-50 md:text-sm", { "border-red-400 focus:outline-red-600": flashcard.errors[:front].any? }] %>
  </div>

  <div class="space-y-2">
    <%= form.label :back, class: "text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" %>
    <%= form.text_area :back, placeholder: t("placeholders.flashcard.back_flashcard"), class: ["flex min-h-[80px] w-full rounded-md border border-gray-300 bg-[#F9FAFB] px-3 py-2 mt-2 text-sm placeholder:text-gray-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-white disabled:cursor-not-allowed disabled:opacity-50", { "border-red-400 focus:outline-red-600": flashcard.errors[:back].any? }] %>
  </div>

  <div class="flex gap-4 pt-4">
    <%= link_to t('buttons.general.back_to_deck'), deck_path(@deck), class: "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium text-[#21242C] ring-offset-white transition duration-300 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-white disabled:pointer-events-none disabled:opacity-50 border border-gray-300 bg-[#F9FAFB] hover:bg-[#8C5AF2] hover:text-white h-10 px-4 py-2 flex-1" %>
    <%= form.submit class: "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-semibold ring-offset-white transition duration-300 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-white disabled:pointer-events-none disabled:opacity-50 bg-[#8C5AF2] text-white hover:bg-[#644FE8] shadow-md hover:shadow-lg h-10 px-4 py-2 flex-1" %>
  </div>
<% end %>

