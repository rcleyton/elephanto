<%= simple_form_for [@deck, @flashcard], class: "contents" do |form| %>
  <div class="px-4 py-3">
    <%= form.input :front, as: "text", input_html: { class: ["bg-[#f0f2f4] shadow-sm rounded-xl border px-3 py-2 mt-2 w-full", 
                                                {"border-none focus:outline-blue-600": flashcard.errors[:front].none?, 
                                                "border-red-400 focus:outline-red-600": flashcard.errors[:front].any?}] },
                           placeholder: "Enter front flashcard" %>
  </div>

  <div class="px-4 py-3">
    <%= form.input :back, as: "text", input_html: { class: ["bg-[#f0f2f4] shadow-sm rounded-xl border px-3 py-2 mt-2 w-full", 
                                               {"border-none focus:outline-blue-600": flashcard.errors[:back].none?, 
                                               "border-red-400 focus:outline-red-600": flashcard.errors[:back].any?}] },
                          placeholder: "Enter back flashcard" %>
  </div>

  <div class="flex px-4 py-3 space-x-3">
    <%= form.submit class: "cursor-pointer overflow-hidden rounded-full h-10 px-4 bg-[#1978e5] text-white text-sm font-bold leading-normal tracking-[0.015em]" %>
    <%= link_to "Back to deck", deck_path(@deck), class: "flex items-center overflow-hidden rounded-full h-10 px-4 bg-[#F1F2F4] text-black text-sm font-bold leading-normal tracking-[0.015em]" %>
  </div>
<% end %>

