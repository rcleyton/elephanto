<%= form_with model: [ @deck, @flashcard ], class: "space-y-8" do |form| %>

  <div class="space-y-2">
    <div class="space-y-0">
      <%= form.label :front, class: "form-label" %>
      <span class="text-xs text-slate-400">A pergunta ou o termo que você verá primeiro</span>
    </div>
    <div class="relative group">
      <div
        class="
          absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400
          group-focus-within:text-[#60c2a6] transition-colors
        "
      >
        <span class="material-symbols-outlined text-xl">flip_to_front</span>
      </div>
      <%= form.text_field :front,
                      placeholder: t("placeholders.flashcard.front_flashcard"),
                      class: "form-input #{error_class(flashcard, :front)}" %>
    </div>
    <% if flashcard.errors[:front].any? %>
      <p class="text-xs font-bold text-red-500 ml-1 mt-1 flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">error</span>
        <%= flashcard.errors[:front].first %>
      </p>
    <% end %>
  </div>

  <div class="space-y-2">
    <div class="space-y-0">
      <%= form.label :back, class: "form-label" %>
      <span class="text-xs text-slate-400">A resposta ou explicação detalhada</span>
    </div>

    <div class="space-y-2" data-controller="rich-text">
      <div class="flex flex-wrap gap-1 px-1" aria-label="Formatação do texto">
        <button type="button" data-action="pointerdown->rich-text#rememberSelection click->rich-text#format" data-command="bold" class="rich-text-toolbar-button" title="Negrito" aria-label="Negrito">
          <span class="material-symbols-outlined text-base">format_bold</span>
        </button>
        <button type="button" data-action="pointerdown->rich-text#rememberSelection click->rich-text#format" data-command="italic" class="rich-text-toolbar-button" title="Itálico" aria-label="Itálico">
          <span class="material-symbols-outlined text-base">format_italic</span>
        </button>
        <button type="button" data-action="pointerdown->rich-text#rememberSelection click->rich-text#format" data-command="underline" class="rich-text-toolbar-button" title="Sublinhado" aria-label="Sublinhado">
          <span class="material-symbols-outlined text-base">format_underlined</span>
        </button>
        <button type="button" data-action="pointerdown->rich-text#rememberSelection click->rich-text#format" data-command="strikeThrough" class="rich-text-toolbar-button" title="Tachado" aria-label="Tachado">
          <span class="material-symbols-outlined text-base">format_strikethrough</span>
        </button>
        <button type="button" data-action="pointerdown->rich-text#rememberSelection click->rich-text#format" data-command="insertUnorderedList" class="rich-text-toolbar-button" title="Lista com marcadores" aria-label="Lista com marcadores">
          <span class="material-symbols-outlined text-base">format_list_bulleted</span>
        </button>
        <button type="button" data-action="pointerdown->rich-text#rememberSelection click->rich-text#format" data-command="insertOrderedList" class="rich-text-toolbar-button" title="Lista numerada" aria-label="Lista numerada">
          <span class="material-symbols-outlined text-base">format_list_numbered</span>
        </button>
      </div>

      <div class="relative group">
        <div
          class="absolute left-0 top-4 z-10 flex items-start pl-4 text-slate-400 pointer-events-none
            group-focus-within:text-[#60c2a6] transition-colors"
        >
          <span class="material-symbols-outlined text-xl">flip_to_back</span>
        </div>
        <%= form.text_area :back,
                            data: { rich_text_target: "input" },
                            class: "hidden" %>
        <div
          contenteditable="true"
          role="textbox"
          aria-multiline="true"
          aria-label="<%= Flashcard.human_attribute_name(:back) %>"
          data-rich-text-target="editor"
          data-action="input->rich-text#sync blur->rich-text#sync keyup->rich-text#rememberSelection mouseup->rich-text#rememberSelection"
          data-placeholder="<%= t("placeholders.flashcard.back_flashcard") %>"
          class="form-input rich-text-editor min-h-32 <%= error_class(flashcard, :back) %>"
        ></div>
      </div>
    </div>
    <% if flashcard.errors[:back].any? %>
      <p class="text-xs font-bold text-red-500 ml-1 mt-1 flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">error</span>
        <%= flashcard.errors[:back].first %>
      </p>
    <% end %>
  </div>


  <div class="pt-6 flex flex-col sm:flex-row gap-4">
    <%= link_to t("buttons.general.back_to_deck"),
    deck_path(@deck),
    class: "flex-1 flex items-center justify-center rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-6 py-4 text-sm font-black text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all" %>
    <%= form.submit class:
                  "flex-[2] rounded-2xl bg-slate-900 dark:bg-[#60c2a6] px-6 py-4 text-sm font-black text-white dark:text-slate-900 shadow-xl shadow-slate-200 dark:shadow-none transition-all hover:opacity-90 active:scale-[0.98] cursor-pointer uppercase tracking-widest" %>
  </div>
<% end %>
