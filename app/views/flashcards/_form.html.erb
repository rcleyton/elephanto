<div class="border m-3 p-3 bg-gray-50 border-gray-300">
  <%= form_with model: [@deck, @flashcard], class: "contents" do |form| %>
    <% if flashcard.errors.any? %>
      <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
        <h2><%= pluralize(flashcard.errors.count, "error") %> prohibited this deck from being saved:</h2>

        <ul class="list-disc ml-6">
          <% flashcard.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    
    <div class="my-5">
      <%= form.label :front %>
      <%= form.text_field :front, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": flashcard.errors[:front].none?, "border-red-400 focus:outline-red-600": flashcard.errors[:front].any?}] %>
    </div>

    <div class="my-5">
      <%= form.label :back %>
      <%= form.text_field :back, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": flashcard.errors[:back].none?, "border-red-400 focus:outline-red-600": flashcard.errors[:back].any?}] %>
    </div>

    <div class="inline">
      <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>
</div>
