<div
  class="p-4 md:p-0 min-h-screen bg-gray-100 flex items-center justify-center"
>
  <div
    class="
      rounded-lg border border-[#DCDFE5] bg-white text-[21242C] w-full max-w-md
    "
  >
    <div class="p-8 text-center">
      <div class="text-6xl mb-6">
        🎉
      </div>
      <h2 class="text-2xl font-bold mb-4">Revisão concluída!</h2>
      <% progress = flashcard_progress(@deck) %>
      <p class="text-[#676F7E] mb-6">Você revisou
        <%= progress[:total] %>rds do Deck:
        <%= @deck.name %></p>
      <%= link_to "Voltar para o deck",
      deck_path(@deck),
      class: "btn btn-default-size btn-default-variant w-full" %>
    </div>
  </div>
</div>
