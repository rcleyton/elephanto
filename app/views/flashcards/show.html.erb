<% content_for :title, "#{t('actions.showing')} #{Flashcard.model_name.human.downcase}" %>

<div class="min-h-screen bg-background">
  <% progress = flashcard_progress(@deck) %>
  <% right_button = capture do %>
    <div>
      <p class="text-[#676F7E]"><%= progress[:percent] %>%</p>
    </div>
  <% end %>

  <%= page_header(
    show_back_button: true,
    back_path: deck_path(@deck),
    title: "Revisão: #{@deck.name}",
    subtitle: "Flashcard #{progress[:current]} de #{progress[:total]}",
    show_profile_menu: false,
    right_buttons: right_button
  ) %> 

  <main data-controller="automatic-margin-top" class="container mx-auto px-6 py-8">
    <%= render @flashcard %>
  </main>
<div>
