<% content_for :title, "Revisando #{@deck.name}" %>

<% progress = flashcard_progress(@deck) %>

<%# Navbar de Revisão - Ultra Focada %>
<nav
  class="
    sticky top-0 z-50 border-b border-slate-100 dark:border-slate-800 bg-white/80
    dark:bg-slate-950/80 backdrop-blur-xl px-4 py-4
  "
>
  <div class="max-w-4xl mx-auto flex items-center justify-between gap-6">

    <%# Voltar e Título %>
    <div class="flex items-center gap-4">
      <%= link_to deck_path(@deck), 
          class: "flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-50 dark:bg-slate-900 text-slate-500 hover:text-slate-900 dark:hover:text-white transition-all active:scale-90",
          title: "Sair da revisão" do %>
        <span class="material-symbols-outlined">close</span>
      <% end %>

      <div class="hidden sm:block">
        <h1
          class="
            text-sm font-black text-slate-900 dark:text-white uppercase tracking-tighter
          "
        >
          <%= @deck.name %>
        </h1>
        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">
          Sessão de Estudo
        </p>
      </div>
    </div>

    <%# Progresso Centralizado %>
    <div class="flex-1 max-w-md">
      <div class="flex items-center justify-between mb-2 px-1">
        <span class="text-[10px] font-black text-[#60c2a6] uppercase tracking-widest">
          Card
          <%= progress[:current] %>
          de
          <%= progress[:total] %>
        </span>
        <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">
          <%= progress[:percent] %>%
        </span>
      </div>
      <div
        class="
          h-2.5 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden p-0.5
        "
      >
        <div
          class="
            h-full bg-[#60c2a6] rounded-full shadow-[0_0_10px_rgba(96,194,166,0.4)]
            transition-all duration-500 ease-out
          "
          style="width: <%= progress[:percent] %>%"
        ></div>
      </div>
    </div>

    <%# Contador de Streak ou Badge (Opcional - Visual) %>
    <div
      class="
        hidden md:flex items-center gap-2 px-3 py-1.5 rounded-xl bg-orange-50
        dark:bg-orange-950/30 text-orange-500 border border-orange-100
        dark:border-orange-900/50
      "
    >
      <span class="material-symbols-outlined text-sm font-bold">local_fire_department</span>
      <span class="text-[10px] font-black uppercase">Foco Ativo</span>
    </div>
  </div>
</nav>

<%# Área Principal do Card %>
<main
  class="
    relative min-h-[calc(100vh-81px)] flex flex-col items-center justify-center px-6
    py-12 overflow-hidden
  "
>

  <%# Elementos de Fundo Decorativos (Sutis) %>
  <div
    class="
      absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full -z-10
      pointer-events-none
    "
  >
    <div
      class="
        absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px]
        bg-[#60c2a6]/5 rounded-full blur-[100px]
      "
    ></div>
  </div>

  <div class="w-full max-w-2xl animate-in fade-in zoom-in duration-300">
    <%= render partial: "flashcard", locals: { flashcard: @flashcard } %>
  </div>

  <%# Dica de Teclado (Sutil no Rodapé) %>
  <div
    class="
      mt-12 hidden lg:flex items-center gap-6 text-slate-400 dark:text-slate-600
    "
  >
    <div class="flex items-center gap-2">
      <kbd
        class="
          px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50
          dark:bg-slate-900 text-[10px] font-black
        "
      >ESPAÇO</kbd>
      <span class="text-[10px] font-bold uppercase tracking-widest">Revelar</span>
    </div>
    <div class="flex items-center gap-2">
      <kbd
        class="
          px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50
          dark:bg-slate-900 text-[10px] font-black
        "
      >1-4</kbd>
      <span class="text-[10px] font-bold uppercase tracking-widest">Avaliar</span>
    </div>
  </div>
</main>
