<% content_for :title, "#{t('actions.showing')} #{Flashcard.model_name.human.downcase}" %>

<div class="min-h-screen bg-background">
  <header class="border-b border-border/50 bg-background/80 backdrop-blur-lg" data-controller="header">
    <div class="container mx-auto px-6 py-6">
      <div class="flex flex-col space-y-2 md:space-y-0 md:flex-row justify-start md:items-center md:justify-between">
        <div class="flex items-center gap-4">
          <%= link_to deck_path(@deck), class: "icon-arrow-left inline-flex items-center justify-center rounded-md ring-offset-white transition duration-300 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 hover:bg-[#8C5AF2] h-10 w-10" do %>
            <%= image_tag "arrow-left.svg", class: "h-4 w-4" %>
          <% end %>
          <div>
            <h1 class="text-3xl font-bold bg-primary bg-clip-text text-transparent">Revisão: <%= @deck.name %></h1>
            <% progress = flashcard_progress(@deck) %>
            <p class="text-muted-foreground mt-2">
              Flashcard <%= progress[:current] %> de <%= progress[:total] %>
            </p>
          </div>
        </div>
        <div>
          <p class="text-[#676F7E]"><%= progress[:percent] %>%</p>
        </div>
      </div>
    </div>
  </header>
  <div class="w-full bg-gray-200 h-2.5 dark:bg-gray-700">
    <div class="bg-blue-600 h-2.5" style="width: <%= progress[:percent] %>%"></div>
  </div> 
  <div class="container mx-auto px-6 py-12">
    <%= render @flashcard %>
  </div>
<div>
