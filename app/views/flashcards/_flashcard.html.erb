<div id="<%= dom_id flashcard %>" data-controller="reveal">
  <div class="flex justify-between">
    <div>
      <strong class="block font-medium mb-1">Front:</strong>
      <%= flashcard.front %>
    </div>
    <button data-action="reveal#show" type="button" class="text-center rounded-md px-3.5 py-2.5 bg-green-600 hover:bg-green-500 font-medium text-white">Answer</button>
  </div>

  <div data-reveal-target="item" class="hidden">
    <strong  class="block font-medium mb-1">Back:</strong>
    <%= flashcard.back %>
  </div>
</div>