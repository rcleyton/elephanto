<div id="<%= dom_id flashcard %>" data-controller="reveal" class="h-full flex flex-col justify-between">
  <div>
    <h2 class="text-[#111418] tracking-light text-[28px] font-bold leading-tight px-4 text-center pb-3 pt-5"><%= flashcard.front %></h2>
    
    <div class="flex px-4 py-3 justify-center">
      <button data-action="reveal#show" type="button" class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-[#1978e5] text-white text-sm font-bold leading-normal tracking-[0.015em]">
        <%= t('buttons.general.show_answer') %>
      </button>
    </div>
  </div>

  <div data-reveal-target="item" class="hidden h-full flex flex-col justify-between">
    <p class="text-[#111418] tracking-light text-[28px] font-bold leading-tight px-4 text-center pb-3 pt-5"><%= flashcard.back %></p>

    <div class="my-3 flex justify-center space-x-3">
      <%= button_to t('buttons.general.again'), review_deck_flashcard_path(@deck, flashcard),  params: { difficulty: "again" }, method: :post, class: "text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 font-medium text-white cursor-pointer" %>
      <%= button_to t('buttons.general.easy'), review_deck_flashcard_path(@deck, flashcard),   params: { difficulty: "easy" },   method: :post, class: "text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 font-medium text-white cursor-pointer" %>
      <%= button_to t('buttons.general.medium'), review_deck_flashcard_path(@deck, flashcard), params: { difficulty: "medium" }, method: :post, class: "text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 font-medium text-white cursor-pointer" %>
      <%= button_to t('buttons.general.hard'), review_deck_flashcard_path(@deck, flashcard),   params: { difficulty: "hard" }, method: :post, class: "text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 font-medium text-white cursor-pointer" %>
    </div>
  </div>
</div>