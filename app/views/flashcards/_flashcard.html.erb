<div
  id="<%= dom_id flashcard %>"
  data-controller="reveal"
  class="max-w-2xl mx-auto"
>
  <div
    class="
      rounded-lg border bg-white border-gray-200 text-card-foreground min-h-[400px]
    "
  >
    <div
      class="
        p-8 flex flex-col justify-center items-center text-left min-h-[400px]
      "
    >
      <div class="w-full">
        <div class="mb-8">
          <h3 class="text-sm font-medium text-[#676F7E] mb-2">Pergunta</h3>
          <p class="text-2xl font-bold mb-8 text-[#21242C]"><%= flashcard.front %></p>

          <button
            data-action="reveal#show"
            data-hide-button-target="button"
            type="button"
            class="btn btn-default-size btn-cta w-full"
          >
            <%= t("buttons.general.show_answer") %>
          </button>
        </div>

        <div data-reveal-target="item" class="mb-8 hidden">
          <h3 class="text-sm font-medium text-[#676F7E] mb-2">Resposta</h3>
          <div class="text-xl font-semibold mb-8 text-[#594DE6]"><%= simple_format(flashcard.back) %></div>
          <div class="space-y-4">
            <div class="text-[#676F7E] text-sm mb-4">Como foi sua resposta?</div>
            <div class="grid grid-cols-2 gap-3">
              <%= button_to review_deck_flashcard_path(@deck, flashcard),
                params: { rating: Fsrs::Rating::AGAIN }, method: :post, class: "btn btn-default-size btn-destructive w-full" do %>
                <%= t("buttons.general.again") %>
              <% end %>
              <%= button_to review_deck_flashcard_path(@deck, flashcard), params: { rating: Fsrs::Rating::HARD }, method: :post, class: "btn btn-default-size btn-outline w-full" do %>
                <%= t("buttons.general.hard") %>
              <% end %>
              <%= button_to review_deck_flashcard_path(@deck, flashcard), params: { rating: Fsrs::Rating::GOOD },
                method: :post, class: "btn btn-default-size btn-secondary w-full" do %>
                <%= t("buttons.general.medium") %>
              <% end %>
              <%= button_to review_deck_flashcard_path(@deck, flashcard), params: { rating: Fsrs::Rating::EASY }, method: :post, class: "btn btn-default-size btn-cta w-full" do %>
                <%= t("buttons.general.easy") %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initHideButton() {
    const btn = document.querySelector('.button-hide');
    if (!btn) return;

    btn.addEventListener('click', () => {
      btn.style.display = 'none';
    }, {
      once: true
    });
  }

  document.addEventListener('DOMContentLoaded', initHideButton);
  document.addEventListener('turbo:load', initHideButton);
</script>
