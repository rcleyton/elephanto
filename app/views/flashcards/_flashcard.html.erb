<% options = flashcard.review_options %>
<div
  id="<%= dom_id flashcard %>"
  data-controller="reveal"
  class="w-full max-w-2xl mx-auto"
>

  <%# Card Principal %>
  <div
    class="
      bg-white dark:bg-slate-900 rounded-[2.5rem] border border-slate-100
      dark:border-slate-800 shadow-2xl shadow-slate-200/50 dark:shadow-none
      overflow-hidden transition-all
    "
  >

    <%# Área da Pergunta %>
    <div class="p-6 md:p-10 text-center">
      <span
        class="
          inline-block text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase
          tracking-[0.3em] mb-6
        "
      >
        Pergunta
      </span>
      <h2
        class="
          text-xl md:text-2xl font-black text-slate-900 dark:text-white leading-tight
          tracking-tight
        "
      >
        <%= flashcard.front %>
      </h2>
    </div>

    <%# Botão de Revelar %>
    <div class="px-8 pb-12" id="show-answer-container">
      <button
        data-action="reveal#show"
        data-hide-button-target="button"
        type="button"
        class="
          button-hide w-full bg-slate-900 dark:bg-[#60c2a6] hover:opacity-90 text-white
          dark:text-slate-900 font-black py-5 rounded-2xl shadow-xl shadow-slate-200
          dark:shadow-emerald-900/20 transition-all active:scale-[0.98] flex items-center
          justify-center gap-3 uppercase tracking-widest text-sm
        "
      >
        <span class="material-symbols-outlined">visibility</span>
        <%= t("buttons.general.show_answer") %>
      </button>
    </div>

    <%# Área da Resposta (Revelada) %>
    <div
      data-reveal-target="item"
      class="
        hidden animate-in fade-in slide-in-from-bottom-8 duration-500 ease-out
      "
      id="answer-section"
    >
      <div class="px-8 md:px-12 pb-12">
        <div class="relative mb-12">
          <div class="absolute inset-0 flex items-center" aria-hidden="true">
            <div
              class="
                w-full border-t border-dashed border-slate-200 dark:border-slate-800
              "
            ></div>
          </div>
          <div class="relative flex justify-center">
            <span
              class="
                bg-white dark:bg-slate-900 px-4 text-[10px] font-black text-slate-400 uppercase
                tracking-widest
              "
            >Resposta</span>
          </div>
        </div>

        <div
          class="
            p-8 bg-slate-50 dark:bg-slate-950 rounded-[2rem] border border-slate-100
            dark:border-slate-800 mb-12
          "
        >
          <div class="rich-text-content text-base font-black text-stone-700 text-center leading-relaxed">
            <%= sanitize flashcard.back, tags: %w[b strong i em u s strike del ul ol li p div br] %>
          </div>
        </div>

        <%# Grade de Avaliação FSRS %>
        <div class="space-y-6">
          <p
            class="
              text-center text-[10px] font-black text-slate-400 uppercase tracking-widest
            "
          >Qual foi o nível de dificuldade?</p>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <%# Novamente (Vermelho) %>
            <%= button_to review_deck_flashcard_path(@deck, flashcard), params: { rating: Fsrs::Rating::AGAIN }, method: :post, class: "group flex flex-col items-center p-4 rounded-2xl bg-white dark:bg-slate-900 border-2 border-rose-100 dark:border-rose-900/30 hover:bg-rose-500 dark:hover:bg-rose-600 transition-all duration-200" do %>
              <span
                class="
                  text-xs font-black text-rose-600 dark:text-rose-400 group-hover:text-white
                  uppercase tracking-tighter
                "
              ><%= t("buttons.general.again") %></span>
              <span
                class="
                  text-[9px] mt-1 font-bold text-rose-400 group-hover:text-rose-100 uppercase
                  tracking-tighter
                "
              >
                <%= format_fsrs_interval(options[:again]) %>
              </span>
            <% end %>

            <%# Difícil (Slate) %>
            <%= button_to review_deck_flashcard_path(@deck, flashcard), params: { rating: Fsrs::Rating::HARD }, method: :post, class: "group flex flex-col items-center p-4 rounded-2xl bg-white dark:bg-slate-900 border-2 border-slate-100 dark:border-slate-800 hover:bg-slate-800 dark:hover:bg-slate-700 transition-all duration-200" do %>
              <span
                class="
                  text-xs font-black text-slate-600 dark:text-slate-300 group-hover:text-white
                  uppercase tracking-tighter
                "
              ><%= t("buttons.general.hard") %></span>
              <span
                class="
                  text-[9px] mt-1 font-bold text-slate-400 group-hover:text-slate-300 uppercase
                  tracking-tighter
                "
              >
                <%= format_fsrs_interval(options[:hard]) %>
              </span>
            <% end %>

            <%# Bom (Slate) %>
            <%= button_to review_deck_flashcard_path(@deck, flashcard), params: { rating: Fsrs::Rating::GOOD }, method: :post, class: "group flex flex-col items-center p-4 rounded-2xl bg-white dark:bg-slate-900 border-2 border-slate-100 dark:border-slate-800 hover:bg-slate-800 dark:hover:bg-slate-700 transition-all duration-200" do %>
              <span
                class="
                  text-xs font-black text-slate-600 dark:text-slate-300 group-hover:text-white
                  uppercase tracking-tighter
                "
              ><%= t("buttons.general.medium") %></span>
              <span
                class="
                  text-[9px] mt-1 font-bold text-slate-400 group-hover:text-slate-300 uppercase
                  tracking-tighter
                "
              >
                <%= format_fsrs_interval(options[:good]) %>
              </span>
            <% end %>

            <%# Fácil (Verde Elephanto) %>
            <%= button_to review_deck_flashcard_path(@deck, flashcard), params: { rating: Fsrs::Rating::EASY }, method: :post, class: "group flex flex-col items-center p-4 rounded-2xl bg-white dark:bg-slate-900 border-2 border-emerald-100 dark:border-emerald-900/30 hover:bg-[#60c2a6] transition-all duration-200" do %>
              <span
                class="
                  text-xs font-black text-[#60c2a6] group-hover:text-slate-900 uppercase
                  tracking-tighter
                "
              ><%= t("buttons.general.easy") %></span>
              <span
                class="
                  text-[9px] mt-1 font-bold text-emerald-600/60 dark:text-[#60c2a6]/60
                  group-hover:text-slate-900/60 uppercase tracking-tighter
                "
              >
                <%= format_fsrs_interval(options[:easy]) %>
              </span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    function initHideButton() {
      const btn = document.querySelector('.button-hide');
      if (!btn) return;
      btn.addEventListener('click', () => {
        btn.style.display = 'none';
      }, { once: true });
    }
    document.addEventListener('DOMContentLoaded', initHideButton);
    document.addEventListener('turbo:load', initHideButton);
  </script>
</div>
