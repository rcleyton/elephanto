<% options = flashcard.review_options %>
<div
  id="<%= dom_id flashcard %>"
  data-controller="reveal"
  class="max-w-2xl mx-auto"
>

  <div
    class="
      bg-white dark:bg-surface-dark shadow-xl shadow-gray-200/50 dark:shadow-none
      border border-gray-100 dark:border-gray-800 p-8 md:p-12
    "
  >
    <div class="mb-10">
      <span
        class="
          text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-[0.2em]
          mb-2 block
        "
      >Pergunta</span>
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white leading-tight">
        <%= flashcard.front %>
      </h2>
    </div>
    <div class="mb-8" id="show-answer-container">
      <button
        data-action="reveal#show"
        data-hide-button-target="button"
        type="button"
        class="
          w-full bg-primary hover:bg-primary/90 text-white font-bold py-4 rounded-xl
          shadow-lg shadow-primary/25 transition-all active:scale-[0.98] flex items-center
          justify-center gap-2 button-hide
        "
      >
        <span class="material-symbols-outlined">visibility</span>
        <%= t("buttons.general.show_answer") %>
      </button>
    </div>
    <div
      data-reveal-target="item"
      class="hidden animate-in fade-in slide-in-from-bottom-4 duration-500"
      id="answer-section"
    >
      <div class="mb-12">
        <span
          class="
            text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-[0.2em]
            mb-2 block w-full
          "
        >Resposta</span>
        <div
          class="
            p-6 bg-primary/5 dark:bg-primary/10 rounded-2xl border border-primary/20
          "
        >
          <p class="text-2xl font-bold text-primary text-center">
            <%= flashcard.back %>
          </p>
        </div>
      </div>
      <div>
        <div class="text-center mb-6">
          <p class="text-sm font-medium text-gray-500 dark:text-gray-400 italic">Como foi sua resposta?</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <%= button_to review_deck_flashcard_path(@deck, flashcard), params: { rating: Fsrs::Rating::AGAIN }, method: :post, class: "group flex flex-col items-center justify-center p-4 rounded-xl bg-red-50
              dark:bg-red-900/10 border border-red-100 dark:border-red-900/30 hover:bg-red-500
              hover:text-white transition-all duration-200" do %>
            <span
              class="
                text-sm font-bold text-red-600 dark:text-red-400 group-hover:text-white
              "
            ><%= t("buttons.general.again") %></span>
            <span
              class="
                text-[10px] mt-1 text-red-500/70 dark:text-red-400/70 group-hover:text-white/80
              "
            >Revisão em
              <strong><%= format_fsrs_interval(options[:again]) %></strong>
            </span>
          <% end %>

          <%= button_to review_deck_flashcard_path(@deck, flashcard), params: { rating: Fsrs::Rating::HARD }, method: :post, class: "group flex flex-col items-center justify-center p-4 rounded-xl bg-gray-50
              dark:bg-gray-800 border border-gray-100 dark:border-gray-700 hover:bg-gray-200
              dark:hover:bg-gray-700 transition-all duration-200" do %>
            <span class="text-sm font-bold text-gray-700 dark:text-gray-200"><%= t("buttons.general.hard") %></span>
            <span class="text-[10px] mt-1 text-gray-500 dark:text-gray-400">Revisão em
              <strong><%= format_fsrs_interval(options[:hard]) %></strong>
            </span>
          <% end %>

          <%= button_to review_deck_flashcard_path(@deck, flashcard), params: { rating: Fsrs::Rating::GOOD }, method: :post, class: "group flex flex-col items-center justify-center p-4 rounded-xl bg-gray-50
              dark:bg-gray-800 border border-gray-100 dark:border-gray-700 hover:bg-gray-200
              dark:hover:bg-gray-700 transition-all duration-200" do %>
            <span class="text-sm font-bold text-gray-700 dark:text-gray-200"><%= t("buttons.general.medium") %></span>
            <span class="text-[10px] mt-1 text-gray-500 dark:text-gray-400">Revisão em
              <strong><%= format_fsrs_interval(options[:good]) %></strong>
            </span>
          <% end %>

          <%= button_to review_deck_flashcard_path(@deck, flashcard), params: { rating: Fsrs::Rating::EASY }, method: :post, class: "group flex flex-col items-center justify-center p-4 rounded-xl bg-primary/10
              dark:bg-primary/20 border border-primary/20 hover:bg-primary hover:text-white
              transition-all duration-200" do %>
            <span
              class="
                text-sm font-bold text-primary dark:text-primary group-hover:text-white
              "
            ><%= t("buttons.general.easy") %></span>
            <span
              class="
                text-[10px] mt-1 text-primary/70 dark:text-primary group-hover:text-white/80
              "
            >Revisão em
              <strong><%= format_fsrs_interval(options[:easy]) %></strong>
            </span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <script>
  function initHideButton() {
    const btn = document.querySelector('.button-hide');
    if (!btn) return;

    btn.addEventListener('click', () => {
      btn.style.display = 'none';
    }, {
      once: true
    });
  }

  document.addEventListener('DOMContentLoaded', initHideButton);
  document.addEventListener('turbo:load', initHideButton);
  </script>
