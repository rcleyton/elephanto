<% content_for :title, "New flashcard" %>

<div class="w-full border bg-gray-100 border-gray-300">
  <div class="border-b p-3 bg-gray-200 border-gray-300">
    <h1 class="font-bold text-4xl">New flashcard</h1>
  </div>

  <turbo-frame id="flash">
    <%= render "shared/flash" %>
  </turbo-frame>
  
  <%= render "form", flashcard: @flashcard %>

  <div class="flex justify-end space-x-3 m-3">
    <%= link_to "Back to deck", deck_path(@deck), class: "w-full text-center sm:w-auto float-right sm:mt-0 rounded-md px-3.5 py-2.5 bg-gray-500 hover:bg-gray-400 inline-block font-medium text-white" %>
  </div>
</div>