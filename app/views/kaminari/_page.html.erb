<%# Link showing page number
  - available local variables
    page:          a page object for "this" page
    url:           url to this page
    current_page:  a page object for the currently displayed page
    total_pages:   total number of pages
    per_page:      number of items to fetch per page
    remote:        data-remote -%>
  <% if page.current? %>
    <span class="px-3 py-1 border rounded bg-violet-500 text-white font-semibold">
      <%= page.number %>
    </span>
  <% else %>
    <%= link_to page.number,
    url,
    remote: remote,
    rel: page.rel,
    class: "px-3 py-1 border rounded bg-white text-violet-700 hover:bg-violet-100" %>
  <% end %>
