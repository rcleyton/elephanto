<section class="min-h-screen flex items-center justify-center bg-white text-center">
  <div>
    <h1 class="text-5xl font-bold text-gray-800">404</h1>
    <p class="mt-4 text-gray-600">Página não encontrada no app.</p>
    <p class="mt-2 text-gray-500">Talvez o link esteja incorreto ou o recurso tenha sido removido.</p>
    <div class="mt-6 flex justify-center gap-4">
      <%= link_to "Ir para o app", app_root_url, class: "px-4 py-2 bg-primary text-white rounded-lg shadow hover:opacity-90" %>
      <%= link_to "Voltar ao site", root_path, class: "px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-100" %>
    </div>
  </div>
</section>
