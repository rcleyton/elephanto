<section
  class="min-h-screen flex items-center justify-center bg-gray-50 text-center"
>
  <div>
    <h1 class="text-5xl font-bold text-gray-800">404</h1>
    <p class="mt-4 text-gray-600">Página não encontrada.</p>
    <p class="mt-2 text-gray-500">Talvez você esteja tentando acessar uma área do app que fica em outro
      endereço.</p>
    <div class="mt-6 flex justify-center gap-4">
      <%= link_to "Voltar à página inicial",
      root_path,
      class: "px-4 py-2 bg-primary text-white rounded-lg shadow hover:opacity-90" %>
      <%= link_to "Ir para o app",
      app_root_url,
      class: "px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-100" %>
    </div>
  </div>
</section>
