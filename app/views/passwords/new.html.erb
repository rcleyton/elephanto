<div class="min-h-screen flex overflow-hidden">
  <turbo-frame id="flash">
    <%= render "shared/flash" %>
  </turbo-frame>

  <div
    class="
      hidden lg:flex lg:w-1/2 bg-gradient-to-br from-slate-900 via-slate-800
      to-[#60c2a6] items-center justify-center p-12
    "
  >
    <div class="text-center text-white max-w-md">
      <h1 class="text-5xl font-extrabold mb-6 tracking-tight">Bem-vindo(a) de volta ao Elephanto</h1>
      <p class="text-xl text-emerald-50 opacity-90 leading-relaxed">
        Recupere sua senha e volte a aprender usando repetição espaçada.
      </p>
      <div class="mt-12">
        <%= image_tag "logo_ligth.svg",
        class: "w-48 h-48 mx-auto filter brightness-0 invert opacity-90" %>
      </div>
    </div>
  </div>

  <div
    class="
      flex-1 flex items-center justify-center p-6 bg-gradient-to-br from-slate-900
      via-slate-800 to-[#60c2a6] md:bg-none md:bg-slate-50
    "
  >
    <div class="w-full max-w-md">
      <div
        class="
          bg-white rounded-[2.5rem] border border-slate-200 shadow-2xl md:shadow-xl p-8
          md:p-10
        "
      >

        <%# Cabeçalho do Card %>
        <div class="text-center mb-10">
          <div
            class="
              bg-emerald-50 w-16 h-16 rounded-2xl flex items-center justify-center mx-auto
              mb-6
            "
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8 text-[#60c2a6]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
              />
            </svg>
          </div>
          <h3 class="text-3xl font-bold text-slate-900 tracking-tight">Esqueceu a sua senha?</h3>
          <p class="text-slate-500 mt-3 leading-relaxed">
            Vamos enviar um link para definir a senha no seu e-mail
            cadastrado.
          </p>
        </div>

        <div class="pt-0">
          <%= form_with url: passwords_path, class: "space-y-6" do |form| %>

            <%# Campo de E-mail %>
            <div class="space-y-2">
              <%= form.label :email_address,
                         "E-mail",
                         class: "block text-sm font-semibold text-slate-700 ml-1" %>
              <%= form.email_field :email_address,
                               required: true,
                               autofocus: true,
                               autocomplete: "email",
                               placeholder: t("placeholders.user.email_address"),
                               value: params[:email_address],
                               class:
                                 "w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-[#60c2a6] focus:border-transparent outline-none transition-all placeholder:text-slate-400" %>
            </div>

            <%# Botão de Envio %>
            <%= form.submit t("buttons.submit.email_reset_instructions"),
                        class:
                          "w-full py-4 bg-slate-900 text-white font-bold rounded-2xl hover:bg-slate-800 transition-all shadow-lg active:scale-[0.98] cursor-pointer" %>

            <%# Links de Navegação %>
            <div class="mt-8 text-center border-t border-slate-100 pt-6">
              <%= link_to new_session_path, class: "inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-[#60c2a6] transition-colors" do %>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 19l-7-7m0 0l7-7m-7 7h18"
                  />
                </svg>
                Voltar para o login
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
