<div class="min-h-screen flex overflow-hidden">
  <turbo-frame id="flash">
    <%= render "shared/flash" %>
  </turbo-frame>
  <div class="hidden lg:flex lg:w-1/2 bg-gradient-third items-center justify-center p-8 bg-emerald-400">
    <div class="text-center text-white">
      <h1 class="text-4xl font-bold mb-4">Bem vindo de volta ao Elephanto</h1>
      <p class="text-xl opacity-90">
        Recupere sua senha e volte a aprender usando repetição espaçada
      </p>
      <div class="mt-8">
        <%= image_tag "logo_ligth.svg", class: "w-48 h-48 mx-auto filter brightness-0 invert" %>
      </div>
    </div>
  </div>
  <div class="flex-1 flex items-center justify-center p-8 bg-gray-100">
    <div class="rounded-lg border border-gray-300 bg-white text-gray-900 shadow-sm w-full max-w-md">
      <div class="flex flex-col space-y-1.5 p-6 text-center">
        <div>
          <h3 class="text-2xl font-semibold leading-none tracking-tight">Esqueceu a sua senha?</h3>
          <p class="text-sm text-gray-500 mt-2">Vamos enviar um link para definir a senha no seu email cadastrado</p>
        </div>
      </div>
      <div class="p-6 pt-0">
        <%= form_with url: passwords_path, class: "space-y-6" do |form| %>
          <div class="space-y-2">
            <%= form.label :email_address, "Email", class: "ui-label" %>
            <%= form.email_field :email_address, 
              required: true, 
              autofocus: true, autocomplete: "email", 
              placeholder: t('placeholders.user.email_address'), 
              value: params[:email_address], 
              class: "ui-input mt-2" %>
          </div>
          <%= form.submit t('buttons.submit.email_reset_instructions'), class: "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-emerald-600 text-white hover:bg-emerald-700 shadow-md hover:shadow-lg transition duration-300 ease-in-out h-10 px-4 py-2 w-full" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
