<div class="min-h-screen flex overflow-hidden">    
  <turbo-frame id="flash">
    <%= render "shared/flash" %>
  </turbo-frame>
  <div class="hidden lg:flex lg:w-1/2 bg-gradient-third items-center justify-center p-8 bg-emerald-400">
    <div class="text-center text-white">
      <h1 class="text-4xl font-bold mb-4">Bem vindo de volta ao Elephanto</h1>
      <p class="text-xl opacity-90">
        Atualize sua senha e volte a aprender usando repetição espaçada
      </p>
      <div class="mt-8">
        <%= image_tag "logo_ligth.svg", class: "w-48 h-48 mx-auto filter brightness-0 invert" %>
      </div>
    </div>
  </div>
  <div class="flex-1 flex items-center justify-center p-8 bg-gray-100">
    <div class="rounded-lg border border-gray-300 bg-white text-gray-900 shadow-sm w-full max-w-md">
      <div class="flex flex-col space-y-1.5 p-6 text-center">
        <h3 class="text-2xl font-semibold leading-none tracking-tight"><%= t('messages.update_your_password') %></h3>
      </div>
      <div class="p-6 pt-0">
        <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-6" do |form| %>
          <div class="space-y-2">
            <%= form.label User.human_attribute_name(:password), class: "ui-label" %>
            <%= form.password_field :password, required: true, 
              autocomplete: "new-password", 
              placeholder: t('placeholders.user.new_password'), 
              maxlength: 72, 
              class: "ui-input mt-2 #{error_class(@user, :password)}" %>
          </div>
          <div class="space-y-2">
            <%= form.label User.human_attribute_name(:password_confirmation), class: "ui-label" %>
            <%= form.password_field :password_confirmation, required: true, 
              autocomplete: "new-password", 
              placeholder: t('placeholders.user.repeat_new_password'), 
              maxlength: 72, 
              class: "ui-input mt-2" %>
          </div>
          <%= form.submit t('buttons.submit.save'), class: "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-emerald-600 text-white hover:bg-emerald-700 shadow-md hover:shadow-lg transition duration-300 ease-in-out h-10 px-4 py-2 w-full" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

