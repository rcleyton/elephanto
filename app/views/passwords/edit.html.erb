<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-100 via-purple-100 to-gray-200">
  <div class="mx-auto w-full max-w-md px-4 sm:px-6 py-8 bg-white rounded-xl shadow-xl border border-gray-200">
    
  <turbo-frame id="flash">
    <%= render "shared/flash" %>
  </turbo-frame>

    <h1 class="text-3xl font-semibold text-gray-900 text-center mb-8" style="font-family: 'Inter', sans-serif;"><%= t('messages.update_your_password') %></h1>

    <%= form_with url: password_path(params[:token]), method: :put, html: { class: "space-y-6" } do |form| %>
      <div class="relative">
        <%= form.label User.human_attribute_name(:password), class: "block text-sm font-medium text-gray-700" %>
        <div class="absolute inset-y-0 left-0 top-6 flex items-center pl-3">
          <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <use xlink:href="#icon-lock"/>
          </svg>
        </div>
        <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: t('placeholders.user.new_password'), maxlength: 72, class: "mt-1 block w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200 ease-in-out text-gray-900" %>
      </div>

      <div class="relative">
        <%= form.label User.human_attribute_name(:password_confirmation), class: "block text-sm font-medium text-gray-700" %>
        <div class="absolute inset-y-0 left-0 top-6 flex items-center pl-3">
          <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <use xlink:href="#icon-lock"/>
          </svg>
        </div>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: t('placeholders.user.repeat_new_password'), maxlength: 72, class: "mt-1 block w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200 ease-in-out text-gray-900" %>
      </div>

      <div class="flex justify-center">
        <%= form.submit t('buttons.submit.save'), class: "w-full sm:w-auto px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg shadow-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition duration-200 ease-in-out", style: "font-family: 'Inter', sans-serif;" %>
      </div>
    <% end %>
  </div>
</div>

