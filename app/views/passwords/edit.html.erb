<div class="min-h-screen flex overflow-hidden">
  <turbo-frame id="flash">
    <%= render "shared/flash" %>
  </turbo-frame>
  <div
    class="
      hidden lg:flex lg:w-1/2 bg-gradient-to-br from-slate-900 via-slate-800
      to-[#60c2a6] items-center justify-center p-12
    "
  >
    <div class="text-center text-white max-w-md">
      <h1 class="text-5xl font-extrabold mb-6 tracking-tight">Bem-vindo(a) de volta ao Elephanto</h1>
      <p class="text-xl text-emerald-50 opacity-90 leading-relaxed">
        Atualize sua senha e volte a aprender utilizando a repetição espaçada.
      </p>
      <div class="mt-12">
        <%= image_tag "logo_ligth.svg",
        class: "w-48 h-48 mx-auto filter brightness-0 invert opacity-90" %>
      </div>
    </div>
  </div>

  <div
    class="
      flex-1 flex items-center justify-center p-6 bg-gradient-to-br from-slate-900
      via-slate-800 to-[#60c2a6] md:bg-none md:bg-slate-50
    "
  >
    <div class="w-full max-w-md">
      <div
        class="
          bg-white rounded-[2.5rem] border border-slate-200 shadow-2xl md:shadow-xl p-8
          md:p-10
        "
      >

        <%# Cabeçalho do Card %>
        <div class="text-center mb-10">
          <div
            class="
              bg-emerald-50 w-16 h-16 rounded-2xl flex items-center justify-center mx-auto
              mb-6
            "
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8 text-[#60c2a6]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              />
            </svg>
          </div>
          <h3 class="text-3xl font-bold text-slate-900 tracking-tight">
            <%= t("messages.update_your_password") %>
          </h3>
          <p class="text-slate-500 mt-3">Escolha uma senha forte para proteger sua conta.</p>
        </div>

        <div class="pt-0">
          <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-6" do |form| %>

            <%# Nova Senha %>
            <div class="space-y-2">
              <%= form.label :password,
                         User.human_attribute_name(:password),
                         class: "block text-sm font-semibold text-slate-700 ml-1" %>
              <%= form.password_field :password,
                                  required: true,
                                  autocomplete: "new-password",
                                  placeholder: t("placeholders.user.new_password"),
                                  maxlength: 72,
                                  class:
                                    "w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-[#60c2a6] focus:border-transparent outline-none transition-all placeholder:text-slate-400 #{"border-red-500" if @user&.errors&.include?(:password)}" %>
            </div>

            <%# Confirmação da Senha %>
            <div class="space-y-2">
              <%= form.label :password_confirmation,
                         User.human_attribute_name(:password_confirmation),
                         class: "block text-sm font-semibold text-slate-700 ml-1" %>
              <%= form.password_field :password_confirmation,
                                  required: true,
                                  autocomplete: "new-password",
                                  placeholder: t("placeholders.user.repeat_new_password"),
                                  maxlength: 72,
                                  class:
                                    "w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-[#60c2a6] focus:border-transparent outline-none transition-all placeholder:text-slate-400" %>
            </div>

            <%# Botão Salvar %>
            <%= form.submit t("buttons.submit.save"),
                        class:
                          "w-full py-4 bg-slate-900 text-white font-bold rounded-2xl hover:bg-slate-800 transition-all shadow-lg active:scale-[0.98] cursor-pointer" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
