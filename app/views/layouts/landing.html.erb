<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Elephanto" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= favicon_link_tag "favicon.ico", type: "image/png" %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin=""/>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900&family=Playwrite+HU:wght@100..400&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-white text-slate-900">
    <header>
      <nav
        class="
          fixed top-0 w-full z-50 bg-white/80 backdrop-blur-lg border-b border-gray-200/50
        "
        data-controller="dropdown"
      >
        <div class="container mx-auto px-6">
          <div class="flex items-center justify-between h-16">
            <div class="flex items-center gap-3">
              <%= link_to root_path do %>
                <div class="flex items-center gap-4 text-slate-900">
                  <%= image_tag "logo_dark.svg", class: "w-10 h-10" %>
                  <h1
                    class="
                      text-[#60c2a6] text-lg font-extrabold leading-tight tracking-tight
                    "
                    style='font-family: "Playwrite HU", cursive;'
                  >
                    Elephanto
                  </h1>
                </div>
              <% end %>
            </div>

            <div class="hidden md:flex items-center gap-8">
              <%= link_to "Recursos",
              root_path(anchor: "resources"),
              class: "text-slate-600 hover:text-slate-900 transition-colors duration-300" %>
              <%= link_to "Como funciona",
              root_path(anchor: "how_work"),
              class: "text-slate-600 hover:text-slate-900 transition-colors duration-300" %>
            </div>

            <div class="hidden md:flex items-center gap-4">
              <%= link_to "Entrar",
              new_session_url,
              class:
                "px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 rounded-lg transition-colors" %>
              <%= link_to "Registrar",
              sign_up_url,
              class:
                "px-4 py-2 text-sm font-bold text-white bg-[#60c2a6] hover:bg-[#4eb095] rounded-lg shadow-md hover:shadow-lg transition-all" %>
            </div>

            <button
              data-action="dropdown#toggle"
              class="
                p-2 rounded-md md:hidden hover:bg-slate-100 text-slate-600
              "
            >
              <svg
                data-dropdown-target="icon"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-6 h-6"
              >
                <line x1="4" x1="20" y1="12" y2="12"></line>
                <line x1="4" x1="20" y1="6" y2="6"></line>
                <line x1="4" x1="20" y1="18" y2="18"></line>
              </svg>
            </button>
          </div>

          <div class="hidden py-4 border-t border-gray-100" data-dropdown-target="menu">
            <div class="flex flex-col gap-2">
              <%= link_to "Recursos",
              root_path(anchor: "resources"),
              data: {
                action: "dropdown#close",
              },
              class: "text-slate-600 hover:text-slate-900 py-2 transition-colors" %>
              <%= link_to "Como funciona",
              root_path(anchor: "how_work"),
              data: {
                action: "dropdown#close",
              },
              class: "text-slate-600 hover:text-slate-900 py-2 transition-colors" %>
              <div class="flex flex-col gap-2 pt-4 border-t border-gray-100">
                <%= link_to "Entrar",
                new_session_url,
                class:
                  "flex items-center px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 rounded-lg" %>
                <%= link_to "Registrar",
                sign_up_url,
                class:
                  "flex items-center px-4 py-2 text-sm font-bold text-white bg-[#60c2a6] rounded-lg shadow-sm" %>
              </div>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main class="pt-16">
      <%= yield %>
    </main>

    <footer class="bg-slate-50 border-t border-gray-200">
      <div class="container mx-auto px-6 py-12">
        <div class="grid md:grid-cols-4 gap-8">
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <%= image_tag "logo_dark.svg", class: "w-8 h-8" %>
              <span
                class="text-xl font-bold text-[#60c2a6]"
                style='font-family: "Playwrite HU", cursive;'
              >Elephanto</span>
            </div>
            <p class="text-slate-500 text-sm leading-relaxed">
              O sistema inteligente de repetição espaçada que ajuda você a
              memorizar qualquer coisa, para sempre.
            </p>
          </div>
          <div class="space-y-4">
            <h3 class="font-semibold text-slate-900">Produto</h3>
            <div class="space-y-2">
              <a
                href="#resources"
                class="
                  block text-slate-500 hover:text-[#60c2a6] transition-colors text-sm
                "
              >Recursos</a>
              <a
                href="#how_work"
                class="
                  block text-slate-500 hover:text-[#60c2a6] transition-colors text-sm
                "
              >Como funciona</a>
            </div>
          </div>
          <div class="space-y-4">
            <h3 class="font-semibold text-slate-900">Suporte</h3>
            <div class="space-y-2">
              <%= mail_to "cleyton.silva@getelephanto.com",
              "Contato",
              encode: "hex",
              class: "block text-slate-500 hover:text-[#60c2a6] transition-colors text-sm" %>
            </div>
          </div>
          <div class="space-y-4">
            <h3 class="font-semibold text-slate-900">Empresa</h3>
            <div class="space-y-2">
              <%= link_to "Privacidade",
              privacy_path,
              class: "block text-slate-500 hover:text-[#60c2a6] transition-colors text-sm" %>
              <%= link_to "Termos",
              terms_path,
              class: "block text-slate-500 hover:text-[#60c2a6] transition-colors text-sm" %>
            </div>
          </div>
        </div>
        <div
          class="
            border-t border-gray-200 mt-12 pt-8 flex flex-col md:flex-row justify-between
            items-center gap-4 text-slate-500 text-sm
          "
        >
          <p>©
            <%= Date.today.year %>
            Elephanto. Todos os direitos reservados.</p>
          <div class="flex items-center gap-2">
            <span>Feito com</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 text-red-500 fill-current"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
              ></path>
            </svg>
            <span>para aprender em qualquer lugar</span>
          </div>
        </div>
      </div>
    </footer>

    <div
      data-controller="cookie-consent"
      data-cookie-consent-target="banner"
      class="
        hidden fixed inset-x-0 bottom-0 bg-slate-900 text-white px-6 py-4 flex flex-col
        md:flex-row items-center justify-between z-50 gap-4
      "
    >
      <span class="text-sm">Usamos cookies essenciais para garantir o bom funcionamento do
        sistema.</span>
      <button
        data-action="cookie-consent#accept"
        class="
          px-6 py-2 bg-[#60c2a6] hover:bg-[#4eb095] text-white rounded-lg text-sm
          font-bold transition-colors
        "
      >
        Aceitar
      </button>
    </div>
  </body>
</html>
