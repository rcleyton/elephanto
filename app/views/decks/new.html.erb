        />
        <img
          class="
            h-10 w-10 rounded-full border-2 border-white dark:border-slate-900 object-cover
          "
          data-alt="User profile picture of a man smiling"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuBoUAHprzJfPUtrv8xWO7JG9wJTQeqAisGYE1sQoov6TrU_hVZ2EKM45MFZuXsQuYukseXHIyc88Oo30y4QrNmr0UN5ueR9PWku_-Y75dpt-4coufMGfobAVFuoiQv21WwVhaj19Gwi8un3X4596hmFNxaD76_96dFrH2HUItM_wlL6HqrlFI0bPcsQOEl2xBIuYgQWudaeGUrclvBMUyBwHe47MAfssZge8UBO8VP-dCM8BUBe9-THimhrDXY0a8O5tQ5LRBgFBk4"
        />
        <img
          class="
            h-10 w-10 rounded-full border-2 border-white dark:border-slate-900 object-cover
