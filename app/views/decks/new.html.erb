<% content_for :title, "New deck" %>

<div class="layout-content-container flex flex-col max-w-[960px] flex-1">
  <div class="flex flex-wrap justify-between gap-3 p-4">
    <p class="text-[#121416] tracking-light text-[32px] font-bold leading-tight min-w-72">Create Deck</p>
  </div>

  <turbo-frame id="flash">
    <%= render "shared/flash" %>
  </turbo-frame>

  <%= render "form", deck: @deck %>

  <div class="flex justify-end space-x-3 m-3">
    <%= link_to "Back to decks", decks_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-500 hover:bg-gray-400 text-white font-medium" %>
  </div>

</div>


