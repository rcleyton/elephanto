          data-alt="User profile picture of a young woman"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuDRjwvxqZsHHoSxU9J-LglviYr9uOH3U0j-kWqAYaSUJYNRBY84bSl3w1BMS9Df_Eo4mpfHpbAInDVtdXqQP_a0M8raVjk9D9wMwtzWdHPv-9uXE6sEzcnLflC2dvBw6wg0zSJRp2cDlQP286e6cGmWG-A-foNGhbZ8S1_hg4geOTnMmRb2f8ZrXxXwJ1Tx7ffcckueMgn1fOORR2Mo5WiACRlaYm-QQKyk3TTiOrISRDe2Rf1S-DYn9u3NtR-9qXHqmyG3VQet8wk"
