          class="
            flex h-10 w-10 items-center justify-center rounded-full border-2 border-white
            dark:border-slate-900 bg-slate-100 dark:bg-slate-800 text-[10px] font-bold
          "
        >
          +12k
        </div>
      </div>
      <div class="ml-4 flex flex-col justify-center">
        <p class="text-xs font-semibold text-slate-600 dark:text-slate-400">Junte-se a milhares de estudantes</p>
      </div>
    </div>
  </div>
</main>
