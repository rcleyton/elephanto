<% content_for :title, "#{t("actions.new")} #{Deck.model_name.human.downcase}" %>

<turbo-frame id="flash">
  <%= render "shared/flash" %>
</turbo-frame>

<main class="flex flex-1 justify-center py-12 px-4 md:px-10 lg:px-40">
  <div class="flex flex-col max-w-[700px] flex-1">

    <%# Título e Contexto %>
    <div class="flex flex-col gap-2 pb-10 text-center md:text-left">
      <h1
        class="
          text-slate-900 dark:text-white text-3xl md:text-4xl font-black tracking-tight
        "
      >
        <%= t("actions.new") %>
        <%= Deck.model_name.human.downcase %>
      </h1>
      <p class="text-slate-500 dark:text-slate-400 text-base">Crie um novo deck para organizar seus flashcards.</p>
    </div>

    <%# Card do Formulário %>
    <div
      class="
        overflow-hidden rounded-[2.5rem] border border-slate-200 dark:border-slate-800
        bg-white dark:bg-slate-900 shadow-2xl shadow-slate-200/50 dark:shadow-none
      "
    >
      <div class="p-8 md:p-12">
        <%= render "form", deck: @deck %>
      </div>

      <%# Info Footer %>
      <div
        class="
          bg-slate-50 dark:bg-slate-800/30 px-8 py-5 border-t border-slate-100
          dark:border-slate-800 flex items-center justify-center gap-3 text-sm
          text-slate-500 dark:text-slate-400
        "
      >
        <span class="material-symbols-outlined text-lg text-[#60c2a6]">bolt</span>
        <span class="font-medium">Você poderá adicionar os flashcards logo após criar o deck.</span>
      </div>
    </div>

    <%# Social Proof %>
    <div class="mt-12 flex flex-col md:flex-row items-center justify-center gap-4">
      <div class="flex -space-x-3">
        <% 3.times do |i| %>
          <img
            class="
              h-11 w-11 rounded-full border-4 border-white dark:border-slate-950 object-cover
              shadow-sm
            "
            src="https://i.pravatar.cc/150?u=<%= i %>"
          />
        <% end %>
        <div
          class="
            flex h-11 w-11 items-center justify-center rounded-full border-4 border-white
            dark:border-slate-950 bg-slate-100 dark:bg-slate-800 text-[10px] font-black
            shadow-sm dark:text-white
          "
        >
          +12k
        </div>
      </div>
      <p class="text-sm font-bold text-slate-600 dark:text-slate-400 tracking-tight">Junte-se a milhares de estudantes no Elephanto</p>
    </div>
  </div>
</main>
