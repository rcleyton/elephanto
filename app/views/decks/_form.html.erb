<%= form_with model: @deck, class: "space-y-6" do |form| %>
  <div>
    <label class="block text-sm font-medium">Capa (opcional)</label>
    <%= form.file_field :cover_image, class: "mt-2" %>
    <p class="text-xs text-muted-foreground mt-1">
      Se não enviar uma imagem, usaremos uma capa com cor elegante
      automaticamente.
    </p>
  </div>
  <div class="space-y-2">
    <%= form.label :name,
               class:
                 "text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400" %>
    <div class="relative">
      <div
        class="
          pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4
          text-slate-400
        "
      >
        <span class="material-symbols-outlined text-xl">label</span>
      </div>
      <%= form.text_field :name,
                      placeholder: t("placeholders.deck.deck_name"),
                      class:
                        "block w-full rounded-lg border dark:border-slate-700 bg-slate-50 dark:bg-slate-800 py-4 pl-12 pr-4 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all #{error_class(deck, :name)}" %>
    </div>
    <% if deck.errors[:name].any? %>
      <p class="ui-error"><%= Deck.human_attribute_name(:name) %>
        <%= deck.errors[:name].first %></p>
    <% end %>

  </div>
  <div class="space-y-2">
    <%= form.label :tag,
               class:
                 "text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400" %>
    <div class="relative">
      <div
        class="
          pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4
          text-slate-400
        "
      >
        <span class="material-symbols-outlined text-xl">tag</span>
      </div>
      <%= form.text_field :tag,
                      placeholder:
                        "Ex: Inglês, Matemática, Ciências, Programação... ",
                      class:
                        "block w-full rounded-lg border dark:border-slate-700 bg-slate-50 dark:bg-slate-800 py-4 pl-12 pr-4 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all #{error_class(deck, :tag)}" %>
    </div>
    <% if deck.errors[:tag].any? %>
      <p class="ui-error"><%= Deck.human_attribute_name(:tag) %>
        <%= deck.errors[:tag].first %></p>
    <% end %>

  </div>
  <div class="space-y-2">
    <%= form.label :description,
               class:
                 "text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400" %>
    <div class="relative">
      <div
        class="
          pointer-events-none absolute left-0 top-4 flex items-start pl-4 text-slate-400
        "
      >
        <span class="material-symbols-outlined text-xl">description</span>
      </div>
      <%= form.text_area :description,
                     placeholder: t("placeholders.deck.deck_description"),
                     class:
                       "block w-full rounded-lg border dark:border-slate-700 bg-slate-50 dark:bg-slate-800 py-4 pl-12 pr-4 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all resize-none #{error_class(deck, :description)}" %>
    </div>
    <% if deck.errors[:description].any? %>
      <p class="ui-error"><%= Deck.human_attribute_name(:description) %>
        <%= deck.errors[:description].first %></p>
    <% end %>

  </div>

  <div class="pt-4 flex flex-col sm:flex-row gap-4">
    <%= link_to t("buttons.general.cancel"),
    decks_path,
    class:
      "flex flex-1 items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-6 py-4 text-base font-bold text-slate-700 dark:text-slate-300 transition-all hover:bg-slate-50 dark:hover:bg-slate-700 active:scale-[0.98]" %>
    <%= form.submit class:
                  "flex-1 rounded-lg bg-primary px-6 py-4 text-base font-bold text-white shadow-lg shadow-primary/30 transition-all hover:bg-primary/90 hover:shadow-primary/40 active:scale-[0.98]" %>
  </div>
<% end %>
