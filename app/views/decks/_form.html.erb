<div class="border m-3 p-3 bg-gray-50 border-gray-300">
  <%= simple_form_for @deck, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.input :name, input_html: { class: ["block bg-white shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": deck.errors[:name].none?, "border-red-400 focus:outline-red-600": deck.errors[:name].any?}] } %>
    </div>

    <div class="my-5">
      <%= form.input :description, input_html: { class: ["block bg-white shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": deck.errors[:description].none?, "border-red-400 focus:outline-red-600": deck.errors[:description].any?}] } %>
    </div>

    <div class="inline">
      <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>
</div>
