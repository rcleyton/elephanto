<%= form_with model: deck, class: "space-y-8" do |form| %>

  <%# Variáveis de Padronização %>
  <% label_class =
    "block text-xs font-black uppercase tracking-widest text-slate-500 dark:text-slate-400 ml-1 mb-2"
  input_base =
    "block w-full rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 py-4 pl-12 pr-4 text-slate-900 dark:text-white placeholder:text-slate-400 focus:ring-4 focus:ring-[#60c2a6]/20 focus:border-[#60c2a6] focus:outline-none transition-all"
  error_input = "border-red-500 focus:ring-red-500/10 focus:border-red-500" %>

  <%# Campo: Capa do Deck %>
  <div class="group">
    <label class="<%= label_class %>">Capa do Deck (Opcional)</label>
    <div class="mt-2 flex items-center justify-center w-full">
      <label
        class="
          flex flex-col items-center justify-center w-full h-32 border-2 border-dashed
          border-slate-200 dark:border-slate-800 rounded-[1.5rem] cursor-pointer
          bg-slate-50 dark:bg-slate-950 hover:bg-slate-100 dark:hover:bg-slate-900
          transition-all
        "
      >
        <div class="flex flex-col items-center justify-center pt-5 pb-6">
          <span class="material-symbols-outlined text-slate-400 mb-2">image</span>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            <span class="font-bold text-[#60c2a6]">Clique para subir</span>
            ou arraste uma imagem
          </p>
        </div>
        <%= form.file_field :cover_image, class: "hidden" %>
      </label>
    </div>
    <p class="text-[10px] text-slate-400 mt-2 ml-1 italic">
      Se vazio, usaremos uma cor elegante automaticamente.
    </p>
  </div>

  <%# Campo: Nome %>
  <div class="space-y-2">
    <%= form.label :name, class: label_class %>
    <div class="relative group">
      <div
        class="
          absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400
          group-focus-within:text-[#60c2a6] transition-colors
        "
      >
        <span class="material-symbols-outlined text-xl">label</span>
      </div>
      <%= form.text_field :name,
                      placeholder: t("placeholders.deck.deck_name"),
                      class:
                        "#{input_base} #{deck.errors[:name].any? ? error_input : ""}" %>
    </div>
    <% if deck.errors[:name].any? %>
      <p class="text-xs font-bold text-red-500 ml-1 mt-1 flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">error</span>
        <%= deck.errors[:name].first %>
      </p>
    <% end %>
  </div>

  <%# Campo: Categoria/Tag %>
  <div class="space-y-2">
    <%= form.label :tag, class: label_class %>
    <div class="relative group">
      <div
        class="
          absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400
          group-focus-within:text-[#60c2a6] transition-colors
        "
      >
        <span class="material-symbols-outlined text-xl">tag</span>
      </div>
      <%= form.text_field :tag,
                      placeholder: "Ex: Idiomas, Programação...",
                      class:
                        "#{input_base} #{deck.errors[:tag].any? ? error_input : ""}" %>
    </div>
  </div>

  <%# Campo: Descrição %>
  <div class="space-y-2">
    <%= form.label :description, class: label_class %>
    <div class="relative group">
      <div
        class="
          absolute left-0 top-4 flex items-start pl-4 text-slate-400
          group-focus-within:text-[#60c2a6] transition-colors
        "
      >
        <span class="material-symbols-outlined text-xl">description</span>
      </div>
      <%= form.text_area :description,
                     rows: 3,
                     placeholder: t("placeholders.deck.deck_description"),
                     class:
                       "#{input_base} resize-none #{deck.errors[:description].any? ? error_input : ""}" %>
    </div>
  </div>

  <%# Botões de Ação %>
  <div class="pt-6 flex flex-col sm:flex-row gap-4">
    <%= link_to t("buttons.general.cancel"),
    decks_path,
    class:
      "flex-1 flex items-center justify-center rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-6 py-4 text-sm font-black text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all" %>

    <%= form.submit class:
                  "flex-[2] rounded-2xl bg-slate-900 dark:bg-[#60c2a6] px-6 py-4 text-sm font-black text-white dark:text-slate-900 shadow-xl shadow-slate-200 dark:shadow-none transition-all hover:opacity-90 active:scale-[0.98] cursor-pointer uppercase tracking-widest" %>
  </div>
<% end %>
