<%= form_with model: @deck, class: "space-y-6" do |form| %>
  <div>
    <%= form.label :name, class: "ui-label" %>
    <%= form.text_field :name, placeholder: t("placeholders.deck.deck_name"), class: "ui-input #{error_class(deck, :name)}" %>
    <% if deck.errors[:name].any? %>
      <p class="ui-error"><%= Deck.human_attribute_name(:name) %> <%= deck.errors[:name].first %></p>
    <% end %>
  </div>

  <div>
    <%= form.label :description, class: "ui-label" %>
    <%= form.text_area :description, placeholder: t("placeholders.deck.deck_description"), class: "ui-textarea #{error_class(deck, :description)}" %>
    <% if deck.errors[:description].any? %>
      <p class="ui-error"><%= Deck.human_attribute_name(:description) %> <%= deck.errors[:description].first %></p>
    <% end %>
  </div>

  <div class="flex gap-4 pt-4">
    <%= link_to t('buttons.general.cancel'), decks_path, class: "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium text-[#21242C] ring-offset-white transition duration-300 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-white disabled:pointer-events-none disabled:opacity-50 border border-gray-300 bg-[#F9FAFB] hover:bg-[#8C5AF2] hover:text-white h-10 px-4 py-2 flex-1" %>
    <%= form.submit class: "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-semibold ring-offset-white transition duration-300 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-white disabled:pointer-events-none disabled:opacity-50 bg-[#8C5AF2] text-white hover:bg-[#644FE8] shadow-md hover:shadow-lg h-10 px-4 py-2 flex-1" %>
  </div>
<% end %>