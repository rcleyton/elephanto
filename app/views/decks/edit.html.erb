<% content_for :title, "#{t("actions.edit")} #{Deck.model_name.human.downcase}" %>

<turbo-frame id="flash">
  <%= render "shared/flash" %>
</turbo-frame>

<div class="min-h-screen bg-background">
  <%= page_header(
    show_back_button: true,
    back_path: decks_path,
    title: "#{t("actions.edit")} #{Deck.model_name.human.downcase}",
    subtitle: "Edite o seu deck para organizar seus flashcards",
    show_profile_menu: false,
  ) %>

  <main
    data-controller="automatic-margin-top"
    class="container mx-auto px-6 py-8"
  >
    <div class="max-w-2xl mx-auto">
      <div class="rounded-lg border bg-card text-card-foreground">
        <div class="flex flex-col space-y-1.5 p-6">
          <h3 class="text-2xl font-semibold leading-none tracking-tight">Editar deck</h3>
          <p class="text-sm text-muted-foreground">Preencha as informações do seu deck de flashcards</p>
        </div>
        <div class="p-6 pt-0">
          <%= render "form", deck: @deck %>
        </div>
      </div>
    </div>
  </main>
</div>
