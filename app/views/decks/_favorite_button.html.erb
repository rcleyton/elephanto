<%= button_to toggle_favorite_deck_path(deck, filter: filter),
    method: :patch,
    data: { turbo_frame: "_top" },
    class: "flex h-9 w-9 items-center justify-center rounded-full bg-white/90 dark:bg-slate-900/90 shadow-sm transition-all hover:scale-110 active:scale-95" do %>

  <span
    id="<%= dom_id(deck) %>_favorite_icon"
    class="
      material-symbols-outlined text-xl <%= deck.favorite? ? 'text-yellow-500' : 'text-slate-400' %>
    "
    style="<%= 'font-variation-settings: \'FILL\' 1' if deck.favorite? %>"
  >
    star
  </span>

<% end %>
