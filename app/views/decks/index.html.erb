<% content_for :title, "Decks" %>

<div class="layout-content-container flex flex-col max-w-[960px] flex-1">
  <turbo-frame id="flash">
    <%= render "shared/flash" %>
  </turbo-frame>

  <div class="flex flex-wrap justify-between gap-3 p-4">
    <p class="text-[#121416] tracking-light text-[32px] font-bold leading-tight min-w-72"><%= Deck.model_name.human.pluralize %></p>

    <%= link_to new_deck_path, class: "flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-xl h-8 px-4 bg-[#f1f2f4] text-[#121416] text-sm font-semibold leading-normal" do %>
      <span class="truncate"><%= t('buttons.submit.new_deck') %></span>
    <% end %>
  </div>

  <div id="decks" class="flex flex-col gap-6 bg-white px-4 min-h-[72px] py-2">
    <% if @decks.any? %>
      <% @decks.each do |deck| %>
        <%= render deck %>
      <% end %>
    <% else %>
      <p class="text-center my-10">No decks found.</p>
    <% end %>
  </div>
</div>