<% content_for :title, "Decks" %>

<turbo-frame id="flash">
  <%= render "shared/flash" %>
</turbo-frame>

<main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div
    class="
      mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between
    "
  >
    <div>
      <h1
        class="
          text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-4xl
        "
      >Meus
        <%= Deck.model_name.human.pluralize %>
      </h1>
      <p class="mt-2 text-base text-slate-600 dark:text-slate-400">Gerencie seus decks de flashcards e continue seu aprendizado
        personalizado.</p>
    </div>
    <%= link_to new_deck_path, 
      class: "
        inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3
        text-sm font-bold text-white shadow-lg shadow-primary/25 transition-all
        hover:bg-primary/90 hover:shadow-primary/40 active:scale-95
      " do %>
      <span class="material-symbols-outlined text-xl">add_circle</span>
      Novo deck
    <% end %>
  </div>
  <!-- Tabs/Filters -->
  <div
    class="
      mb-8 flex items-center gap-1 border-b border-slate-200 dark:border-slate-800
    "
  >
    <button
      class="
        border-b-2 border-primary px-6 py-3 text-sm font-bold text-primary
      "
    >Todos</button>
    <button
      class="
        border-b-2 border-transparent px-6 py-3 text-sm font-medium text-slate-500
        hover:text-slate-700 dark:hover:text-slate-300
      "
    >Recentes</button>
    <button
      class="
        border-b-2 border-transparent px-6 py-3 text-sm font-medium text-slate-500
        hover:text-slate-700 dark:hover:text-slate-300
      "
    >Favoritos</button>
    <button
      class="
        border-b-2 border-transparent px-6 py-3 text-sm font-medium text-slate-500
        hover:text-slate-700 dark:hover:text-slate-300
      "
    >Arquivados</button>
  </div>
  <% if @decks.any? %>
    <div
      class="
        grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4
      "
    >
      <% @decks.each do |deck| %>
        <%= render deck %>
      <% end %>
    </div>
  <% end %>
</main>
