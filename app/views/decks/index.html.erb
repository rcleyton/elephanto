<% content_for :title, "Decks" %>

<turbo-frame id="flash">
  <%= render "shared/flash" %>
</turbo-frame>

<main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div
    class="
      mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between
    "
  >
    <div>
      <h1
        class="
          text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-4xl
        "
      >Meus
        <%= Deck.model_name.human.pluralize %>
      </h1>
      <p class="mt-2 text-base text-slate-600 dark:text-slate-400">Gerencie seus decks de flashcards e continue seu aprendizado
        personalizado.</p>
    </div>
    <%= link_to new_deck_path, 
      class: "
        inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3
        text-sm font-bold text-white shadow-lg shadow-primary/25 transition-all
        hover:bg-primary/90 hover:shadow-primary/40 active:scale-95
      " do %>
      <span class="material-symbols-outlined text-xl">add_circle</span>
      Novo deck
    <% end %>
  </div>
  <!-- Tabs/Filters -->
  <%= turbo_frame_tag "decks", data: { turbo_action: "advance" } do %>
    <% base_classes = "px-6 py-3 text-sm transition-all duration-200"
    active_class = "border-b-2 border-primary font-bold text-primary"
    inactive_class =
      "border-b-2 border-transparent font-medium text-slate-500 hover:text-slate-700 dark:hover:text-slate-300" %>

    <div
      class="
        mb-8 flex items-center gap-1 border-b border-slate-200 dark:border-slate-800
      "
    >
      <%# Aba: Todos %>
      <%= link_to decks_path, 
      data: { turbo_action: "advance" },
      class: "#{base_classes} #{params[:filter].blank? ? active_class : inactive_class}" do %>
        Todos
      <% end %>

      <%# Aba: Recentes %>
      <%= link_to decks_path(filter: "recent"), 
      data: { turbo_action: "advance" },
      class: "#{base_classes} #{params[:filter] == 'recent' ? active_class : inactive_class}" do %>
        Recentes
      <% end %>

      <%# Aba: Favoritos %>
      <%= link_to decks_path(filter: "favorites"), 
      data: { turbo_action: "advance" },
      class: "#{base_classes} #{params[:filter] == 'favorites' ? active_class : inactive_class}" do %>
        Favoritos
      <% end %>

      <%# Aba: Arquivados %>
      <%= link_to decks_path(filter: "archived"), 
      data: { turbo_action: "advance" },
      class: "#{base_classes} #{params[:filter] == 'archived' ? active_class : inactive_class}" do %>
        Arquivados
      <% end %>
    </div>

    <div id="decks_list">
      <% if @decks.any? %>
        <div
          class="
            grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4
          "
        >
          <% @decks.each do |deck| %>
            <%= render deck %>
          <% end %>
        </div>
      <% else %>
        <% if params[:filter].blank? || params[:filter] == 'recent' %>
          <%= link_to new_deck_path, data: { turbo_frame: "_top" }, class: "mt-4 btn-primary" do %>
            <div
              class="
                group flex flex-col items-center justify-center rounded-2xl border-2
                border-dashed border-slate-200 dark:border-slate-800 bg-slate-50/50
                dark:bg-slate-900/50 p-8 transition-all hover:bg-slate-100
                dark:hover:bg-slate-800
              "
            >
              <div
                class="
                  mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-slate-200
                  dark:bg-slate-700 text-slate-400 group-hover:bg-primary group-hover:text-white
                  transition-all
                "
              >
                <span class="material-symbols-outlined text-3xl">add</span>
              </div>
              <p class="text-base font-bold text-slate-900 dark:text-white">Criar novo deck</p>
              <p class="mt-1 text-center text-xs text-slate-500 dark:text-slate-400">Comece um novo tópico e acelere seu aprendizado</p>
            </div>
          <% end %>
        <% else %>
          <div
            class="
              group flex flex-col items-center justify-center rounded-2xl border-2
              border-dashed border-slate-200 dark:border-slate-800 bg-slate-50/50
              dark:bg-slate-900/50 p-8 transition-all hover:bg-slate-100
              dark:hover:bg-slate-800
            "
          >
            <div
              class="
                mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-slate-200
                dark:bg-slate-700 text-slate-400
              "
            >
              <span class="material-symbols-outlined text-3xl">
                <%= if params[:filter] == "archived"
                  "archive"
                else
                  (params[:filter] == "favorites" ? "star" : "add")
                end %>
              </span>
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">
              <%= if params[:filter] == "archived"
                "Nenhum deck arquivado"
              else
                "Você não tem favoritos"
              end %>
            </h3>
            <p class="mt-1 text-center text-xs text-slate-500 dark:text-slate-400">
              <%= if params[:filter] == "archived"
                "Decks que você terminar ficarão guardados aqui."
              else
                "Clique na estrela em um deck para salvá-lo como favorito."
              end %>
            </p>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</main>
