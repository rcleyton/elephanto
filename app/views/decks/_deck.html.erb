<div
  id="<%= dom_id deck %>"
  class="
    group flex flex-col overflow-hidden rounded-[2rem] bg-white dark:bg-slate-900
    shadow-sm border border-slate-200 dark:border-slate-800 transition-all
    duration-300 hover:shadow-xl hover:-translate-y-1.5 hover:border-[#60c2a6]/30
  "
>
  <%# Header do Card com Imagem/Cor %>
  <div
    class="
      aspect-video w-full overflow-hidden bg-slate-100 dark:bg-slate-800 relative
    "
  >

    <%# Botão Favorito - Com fundo blur para destaque %>
    <div id="<%= dom_id deck %>_favorite_button" class="absolute top-4 left-4 z-10">
      <div class="backdrop-blur-md bg-white/20 dark:bg-black/20 rounded-full p-0.5">
        <%= render "decks/favorite_button", deck: deck, filter: params[:filter] %>
      </div>
    </div>

    <%# Overlay Gradiente para legibilidade %>
    <div
      class="
        absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent
        opacity-60
      "
    ></div>

    <% if deck.cover_image.attached? %>
      <%= image_tag deck.cover_image,
      class:
        "h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" %>
    <% else %>
      <div
        class="
          absolute inset-0 transition-transform duration-700 group-hover:scale-110
        "
        style="background: <%= deck.cover_color.presence || '#60c2a6' %>"
      >
        <%# Textura sutil para cores sólidas %>
        <div
          class="
            absolute inset-0 opacity-10
            bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]
          "
        ></div>
      </div>
    <% end %>

    <%# Badge de Categoria %>
    <div
      class="
        absolute top-4 right-4 rounded-full bg-white/90 dark:bg-slate-900/90 px-3 py-1
        text-[10px] font-black uppercase tracking-widest text-[#60c2a6] shadow-sm
      "
    >
      <%= deck.tag %>
    </div>
  </div>

  <%# Conteúdo do Card %>
  <div class="flex flex-1 flex-col p-6">
    <h3
      class="
        text-xl font-bold text-slate-900 dark:text-white line-clamp-1
        group-hover:text-[#60c2a6] transition-colors
      "
    >
      <%= deck.name %>
    </h3>

    <p
      class="
        mt-2 text-sm text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed
        flex-1
      "
    >
      <%= deck.description %>
    </p>

    <%# Meta informações %>
    <div
      class="
        mt-6 flex items-center gap-4 border-t border-slate-50 dark:border-slate-800/50
        pt-4 text-[11px] font-bold uppercase tracking-wider text-slate-400
      "
    >
      <div class="flex items-center gap-1.5">
        <span class="material-symbols-outlined text-lg text-[#60c2a6]">style</span>
        <span class="text-slate-600 dark:text-slate-300"><%= deck.flashcards.count %></span>
        cards
      </div>
      <div class="flex items-center gap-1.5">
        <span class="material-symbols-outlined text-lg text-[#60c2a6]">event</span>
        <span class="text-slate-600 dark:text-slate-300"><%= l deck.created_at, format: "%d %b" %></span>
      </div>
    </div>

    <%# Ações %>
    <div class="mt-6 flex gap-3">
      <%= link_to deck, 
          class: "flex-[2] flex justify-center items-center gap-2 rounded-xl bg-slate-900 dark:bg-[#60c2a6] py-3 text-xs font-black text-white dark:text-slate-900 transition-all hover:opacity-90 shadow-md active:scale-95", 
          data: { turbo_frame: "_top" } do %>
        ESTUDAR
      <% end %>

      <%= link_to edit_deck_path(deck), 
          class: "flex-1 flex justify-center items-center rounded-xl border border-slate-200 dark:border-slate-700 py-3 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all active:scale-95", 
          data: { turbo_frame: "_top" } do %>
        <span class="material-symbols-outlined text-xl">edit</span>
      <% end %>
    </div>
  </div>
</div>
