<% content_for :title, "Showing deck" %>

<div class="layout-content-container flex flex-col max-w-[960px] flex-1">
  <turbo-frame id="flash">
    <%= render "shared/flash" %>
  </turbo-frame>
  
  <div class="flex flex-wrap justify-between gap-3 p-4">
    <div class="flex min-w-72 flex-col gap-3">
      <p class="text-[#111418] tracking-light text-[32px] font-bold leading-tight"><%= @deck.name %></p>
      <p class="text-[#637488] text-sm font-normal leading-normal">
        <%= @deck.description %>
      </p>
    </div>
    <button
      class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-8 px-4 bg-[#f0f2f4] text-[#111418] text-sm font-medium leading-normal"
    >
      <span class="truncate">Start Studying</span>
    </button>
  </div>
  <div class="flex justify-stretch">
    <div class="flex flex-1 gap-3 flex-wrap px-4 py-3 justify-start">
      <%= link_to edit_deck_path(@deck), class: "flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 px-4 bg-[#f1f2f4] text-[#121416] text-sm font-bold leading-normal tracking-[0.015em]" do %>
        <span class="truncate">Edit Deck</span>
      <% end %>
      <%= button_to @deck, method: :delete, class: "flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 px-4 bg-[#f1f2f4] text-[#121416] text-sm font-bold leading-normal tracking-[0.015em]" do %>
        <span class="truncate">Delete Deck</span>
      <% end %>
    </div>
  </div>

  <h3 class="text-[#121416] text-lg font-bold leading-tight tracking-[-0.015em] px-4 pb-2 pt-4">Deck Overview</h3>

  <div class="p-4 grid grid-cols-[20%_1fr] gap-x-6">
    <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#dde0e3] py-5">
      <p class="text-[#6a7581] text-sm font-normal leading-normal">Flashcards</p>
      <p class="text-[#121416] text-sm font-normal leading-normal"><%= @flashcards.count %></p>
    </div>
    <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#dde0e3] py-5">
      <p class="text-[#6a7581] text-sm font-normal leading-normal">Created</p>
      <p class="text-[#121416] text-sm font-normal leading-normal"><%= @deck.created_at %></p>
    </div>
    <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#dde0e3] py-5">
      <p class="text-[#6a7581] text-sm font-normal leading-normal">Last Studied</p>
      <p class="text-[#121416] text-sm font-normal leading-normal"><%= @deck.created_at %></p>
    </div>
  </div>

  <h3 class="text-[#111418] text-lg font-bold leading-tight tracking-[-0.015em] px-4 pb-2 pt-4">Flashcards</h3>

  <div class="flex px-4 py-3 justify-start">
    <%= link_to new_deck_flashcard_path(@deck), class: "flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 px-4 bg-[#1978e5] text-white text-sm font-bold leading-normal tracking-[0.015em]" do %>
      <span class="truncate">Add Flashcard</span>
    <% end %>
  </div>

  <div class="px-4 py-3 @container">
    <div class="flex overflow-hidden rounded-xl border border-[#dce0e5] bg-white">
      <table class="flex-1">
        <thead>
          <tr class="bg-white">
            <th class="table-d18abba4-203f-4b96-ad66-edbd4246ca40-column-120 px-4 py-3 text-left text-[#111418] w-[400px] text-sm font-medium leading-normal">
              Question
            </th>
            <th
              class="table-d18abba4-203f-4b96-ad66-edbd4246ca40-column-240 px-4 py-3 text-left text-[#111418] w-60 text-[#637488] text-sm font-medium leading-normal"
            ></th>
          </tr>
        </thead>
        <tbody>
          <% @deck.flashcards.each do |flashcard| %>
            <tr class="border-t border-t-[#dce0e5]">
              <td class="table-d18abba4-203f-4b96-ad66-edbd4246ca40-column-120 h-[72px] px-4 py-2 w-[400px] text-[#111418] text-sm font-normal leading-normal">
                <%= flashcard.front %>
              </td>
              <td class="table-d18abba4-203f-4b96-ad66-edbd4246ca40-column-240 h-[72px] px-4 py-2 w-60 text-[#637488] text-sm font-bold leading-normal tracking-[0.015em]">
                Edit | Delete
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <style>
      @container(max-width:120px){.table-d18abba4-203f-4b96-ad66-edbd4246ca40-column-120{display: none;}}
      @container(max-width:240px){.table-d18abba4-203f-4b96-ad66-edbd4246ca40-column-240{display: none;}}
    </style>
  </div>
</div>
