<% content_for :title, "#{t('actions.showing')} #{Deck.model_name.human.downcase}" %>

<div class="min-h-screen bg-gray-100">
  <turbo-frame id="flash">
    <%= render "shared/flash" %>
  </turbo-frame>
  <header class="border-b border-gray-200 border-opacity-50 bg-gray-50/80 backdrop-blur-lg" data-controller="header">
    <div class="container mx-auto px-6 py-6">
      <div class="flex flex-col space-y-2 md:space-y-0 md:flex-row justify-start md:items-center md:justify-between">
        <div class="flex items-center gap-4">
          <%= link_to decks_path, class: "inline-flex items-center justify-center rounded-md ring-offset-white transition duration-300 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0  hover:bg-[#8C5AF2] hover:text-white h-10 w-10" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-icon lucide-arrow-left h-4 w-4"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          <% end %>
          <div>
            <h1 class="text-3xl font-bold bg-[#644FE8] bg-clip-text text-transparent"><%= @deck.name %></h1>
            <p class="text-[#676F7E] text-muted-foreground mt-2"><%= @deck.description %></p>
          </div>
        </div>
        <div class="flex gap-2">
          <%= link_to new_deck_flashcard_path(@deck), class: "inline-flex items-center justify-center whitespace-nowrap grow rounded-md text-sm font-medium ring-offset-white transition duration-300 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 bg-[#8C5AF2] text-white hover:bg-[#644FE8] shadow-md hover:shadow-lg h-10 px-4 py-2 gap-2" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus-icon lucide-plus h-4 w-4"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            <%= t('buttons.submit.new_flashcard') %>
          <% end %>

          <%= link_to review_deck_path(@deck), class: "inline-flex items-center justify-center whitespace-nowrap grow rounded-md text-sm font-medium ring-offset-white transition duration-300 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 bg-[#644FE8] text-white hover:bg-[#8C5AF2] hover:shadow-lg h-10 px-4 py-2 gap-2" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play-icon lucide-play h-4 w-4"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/></svg>
            <%= t('buttons.general.start_studying') %>
          <% end %>
        </div>
      </div>
    </div>
  </header>
  <div class="container mx-auto px-6 py-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <div class="rounded-lg border border-gray-200 bg-white text-gray-500">
        <div class="p-4 text-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open w-8 h-8 text-[#594CE6] mx-auto mb-2"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
          <div class="text-2xl font-bold text-[#21242C]"><%= @deck.flashcards.count %></div>
          <div class="text-sm">Flashcards</div>
        </div>
      </div>
      <div class="rounded-lg border border-gray-200 bg-white text-gray-500">
        <div class="p-4 text-center">
          <div class="text-2xl font-bold text-[#8C5AF2]"><%= t("general.created") %></div>
          <div class="text-sm"><%= l @deck.created_at, format: :only_date %></div>
        </div>
      </div>
      <div class="rounded-lg border border-gray-200 bg-white text-gray-500">
        <div class="p-4 text-center">
          <div class="text-2xl font-bold text-[#594CE6]"><%= t("general.last_studied") %></div>
          <div class="text-sm"><%= @deck.last_reviewed_at.nil? ? 'Nunca revisado' : (l @deck.last_reviewed_at, format: :long) %></div>
        </div>
      </div>
    </div>
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-semibold">Flashcards</h2>
        <span class="text-gray-500"><%= @deck.flashcards.count %> cards</span>
      </div>
      <%= render partial: "flashcards", locals: { flashcards: @flashcards, deck: @deck } %>
    </div>
  </div>
</div>
