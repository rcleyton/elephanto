<% content_for :title, "#{t('actions.showing')} #{Deck.model_name.human.downcase}" %>

<div class="layout-content-container flex flex-col max-w-[960px] flex-1">
  <turbo-frame id="flash">
    <%= render "shared/flash" %>
  </turbo-frame>
  
  <div class="flex flex-wrap justify-between gap-3 p-4">
    <div class="flex min-w-72 flex-col gap-3">
      <p class="text-[#111418] tracking-light text-[32px] font-bold leading-tight"><%= @deck.name %></p>
      <p class="text-[#637488] text-sm font-normal leading-normal">
        <%= @deck.description %>
      </p>
    </div>
    
    <%= link_to review_deck_path(@deck), class: "flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-8 px-4 bg-[#28a745] text-white text-sm font-bold leading-normal" do %>
      <span class="truncate"><%= t('buttons.general.start_studying') %></span>
    <% end %>
  </div>
  <div class="flex justify-stretch">
    <div class="flex flex-1 gap-3 flex-wrap px-4 py-3 justify-start">
      <%= link_to edit_deck_path(@deck), class: "flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 px-4 bg-[#007bff] text-white text-sm font-bold leading-normal tracking-[0.015em]" do %>
        <span class="truncate"><%= t('buttons.submit.edit_deck') %></span>
      <% end %>
      <%= button_to @deck, method: :delete, data: { turbo_confirm: t('general.are_you_sure') }, class: "flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 px-4 bg-[#dc3545] text-white text-sm font-bold leading-normal tracking-[0.015em]" do %>
        <span class="truncate"><%= t('buttons.submit.delete_deck') %></span>
      <% end %>
    </div>
  </div>

  <h3 class="text-[#121416] text-lg font-bold leading-tight tracking-[-0.015em] px-4 pb-2 pt-4"><%= t("general.deck_overview") %></h3>

  <div class="p-4 grid grid-cols-[20%_1fr] gap-x-6">
    <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#dde0e3] py-5">
      <p class="text-[#6a7581] text-sm font-normal leading-normal">Flashcards</p>
      <p class="text-[#121416] text-sm font-normal leading-normal"><%= @deck.flashcards.count %></p>
    </div>
    <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#dde0e3] py-5">
      <p class="text-[#6a7581] text-sm font-normal leading-normal"><%= t("general.created") %></p>
      <p class="text-[#121416] text-sm font-normal leading-normal"><%= l @deck.created_at, format: :long %></p>
    </div>
    <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#dde0e3] py-5">
      <p class="text-[#6a7581] text-sm font-normal leading-normal"><%= t("general.last_studied") %></p>
      <p class="text-[#121416] text-sm font-normal leading-normal"><%= l @deck.created_at, format: :short %></p>
    </div>
  </div>

  <h3 class="text-[#111418] text-lg font-bold leading-tight tracking-[-0.015em] px-4 pb-2 pt-4">Flashcards</h3>

  <div class="flex px-4 py-3 justify-start">
    <%= link_to new_deck_flashcard_path(@deck), class: "flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 px-4 bg-[#1978e5] text-white text-sm font-bold leading-normal tracking-[0.015em]" do %>
      <span class="truncate"><%= t('buttons.submit.new_flashcard') %></span>
    <% end %>
  </div>

  <div class="px-4 py-3 @container">
    <%= render partial: "flashcards", locals: { flashcards: @flashcards } %>

    <style>
      @container(max-width:120px){.table-d18abba4-203f-4b96-ad66-edbd4246ca40-column-120{display: none;}}
      @container(max-width:240px){.table-d18abba4-203f-4b96-ad66-edbd4246ca40-column-240{display: none;}}
    </style>
  </div>
</div>
