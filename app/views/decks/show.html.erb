<% content_for :title, "#{t("actions.showing")} #{Deck.model_name.human.downcase}" %>

<turbo-frame id="flash">
  <%= render "shared/flash" %>
</turbo-frame>

<main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div
    class="
      mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between
    "
  >
    <div>
      <h1
        class="
          text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-4xl
        "
      >Meus
        <%= @deck.name %>
      </h1>
      <p class="mt-2 text-base text-slate-600 dark:text-slate-400"><%= @deck.description %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to new_deck_flashcard_path(@deck), class: "flex-1 md:flex-none flex items-center justify-center gap-2 bg-primary text-white px-4 py-2.5 rounded-lg font-bold text-sm hover:opacity-90 transition-opacity" do %>
        <span class="material-symbols-outlined text-sm">add</span>
        <%= t("buttons.submit.new_flashcard") %>
      <% end %>
      <%= link_to review_deck_path(@deck), class: "flex-1 md:flex-none flex items-center justify-center gap-2 bg-primary/10 dark:bg-primary/20 text-primary px-4 py-2.5 rounded-lg font-bold text-sm hover:bg-primary/20 transition-colors" do %>
        <span class="material-symbols-outlined text-sm">play_arrow</span>
        <%= t("buttons.general.start_studying") %>
      <% end %>
    </div>
  </div>
  <!-- Stats Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
    <!-- Total Card -->
    <div
      class="
        bg-white dark:bg-slate-800 p-6 rounded-xl border border-slate-200
        dark:border-slate-700 shadow-sm
      "
    >
      <div class="flex items-center justify-between mb-4">
        <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Total de flashcards</span>
        <span class="material-symbols-outlined text-primary/60">style</span>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="text-3xl font-bold"><%= @deck.flashcards.count %></span>
        <span class="text-xs font-semibold text-emerald-500">+<%= @deck.flashcards.created_this_week.count %> esta semana</span>
      </div>
    </div>
    <!-- Status Card -->
    <div
      class="
        bg-white dark:bg-slate-800 p-6 rounded-xl border border-slate-200
        dark:border-slate-700 shadow-sm col-span-1 md:col-span-2 lg:col-span-1
      "
    >
      <div class="flex items-center justify-between mb-4">
        <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Estados</span>
        <span class="material-symbols-outlined text-primary/60">monitoring</span>
      </div>
      <div class="flex flex-wrap gap-2">
        <span
          class="
            px-2 py-1 rounded bg-slate-100 dark:bg-slate-700 text-[10px] font-bold uppercase
            tracking-wider
          "
        >Novo(s):
          <%= @status_counts[:new] %></span>
        <span
          class="
            px-2 py-1 rounded bg-amber-100 text-amber-700 dark:bg-amber-900/30
            dark:text-amber-400 text-[10px] font-bold uppercase tracking-wider
          "
        >Aprendendo:
          <%= @status_counts[:learning] %></span>
        <span
          class="
            px-2 py-1 rounded bg-rose-100 text-rose-700 dark:bg-rose-900/30
            dark:text-rose-400 text-[10px] font-bold uppercase tracking-wider
          "
        >Esquecido:
          <%= @status_counts[:relearning] %></span>
        <span
          class="
            px-2 py-1 rounded bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30
            dark:text-emerald-400 text-[10px] font-bold uppercase tracking-wider
          "
        >Aprendido:
          <%= @status_counts[:review] %></span>
      </div>
    </div>
    <!-- Review Card -->
    <div
      class="
        bg-white dark:bg-slate-800 p-6 rounded-xl border border-slate-200
        dark:border-slate-700 shadow-sm
      "
    >
      <div class="flex items-center justify-between mb-4">
        <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Para revisar agora</span>
        <span class="material-symbols-outlined text-primary/60">schedule</span>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="text-3xl font-bold text-primary"><%= @deck.flashcards.due.count %></span>
        <span class="text-xs font-semibold text-slate-400">pendente(s)</span>
      </div>
    </div>
    <!-- Last Review Card -->
    <div
      class="
        bg-white dark:bg-slate-800 p-6 rounded-xl border border-slate-200
        dark:border-slate-700 shadow-sm
      "
    >
      <div class="flex items-center justify-between mb-4">
        <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Última revisão</span>
        <span class="material-symbols-outlined text-primary/60">history</span>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="text-xl font-bold"><%= if @deck.last_reviewed_at.nil?
            "Nunca revisado"
          else
            (l @deck.last_reviewed_at, format: :only_date)
          end %></span>
      </div>
    </div>
  </div>
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-semibold">Flashcards</h2>
      <span class="text-gray-500"><%= @deck.flashcards.count %>
        cards</span>
    </div>
    <% if @deck.flashcards.any? %>
      <%= render partial: "flashcards", locals: { flashcards: @flashcards, deck: @deck } %>
    <% else %>
      <div
          class="
            group flex flex-col items-center justify-center rounded-2xl border-2
            border-dashed border-slate-200 dark:border-slate-800 bg-slate-50/50
            dark:bg-slate-900/50 p-8 transition-all hover:bg-slate-100
            dark:hover:bg-slate-800
          "
        >
          <%= link_to new_deck_flashcard_path(@deck),
            class: "
              mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-slate-200
              dark:bg-slate-700 text-slate-400 group-hover:bg-primary group-hover:text-white
              transition-all
            " do %>
            <span class="material-symbols-outlined text-3xl">add</span>
          <% end %>
          <p class="text-base font-bold text-slate-900 dark:text-white">Criar primeiro flashcard</p>
          <p class="mt-1 text-center text-xs text-slate-500 dark:text-slate-400">Adicione flashcards para começar a estudar</p>
        </div>
      </div>
    <% end %>
  </div>
</main>
