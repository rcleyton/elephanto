<% content_for :title, "#{t("actions.showing")} #{@deck.name}" %>

<turbo-frame id="flash">
  <%= render "shared/flash" %>
</turbo-frame>

<main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <%# Header da Página %>

  <% content_for :page_header_actions do %>

    <%= link_to new_deck_flashcard_path(@deck), class: "flex items-center justify-center gap-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 px-6 py-3.5 rounded-2xl font-bold text-sm hover:bg-slate-200 dark:hover:bg-slate-700 transition-all active:scale-95" do %>
      <span class="material-symbols-outlined text-xl">add_circle</span>
      <%= t("buttons.submit.new_flashcard") %>
    <% end %>

    <%= link_to review_deck_path(@deck), class: "flex items-center justify-center gap-3 bg-slate-900 dark:bg-[#60c2a6] text-white dark:text-slate-900 px-8 py-3.5 rounded-2xl font-black text-sm shadow-xl shadow-emerald-500/20 hover:opacity-90 transition-all active:scale-95 uppercase tracking-widest" do %>
      <span class="material-symbols-outlined text-xl">play_circle</span>
      <%= t("buttons.general.start_studying") %>
    <% end %>

  <% end %>

  <%= render "shared/page_header",
  eyebrow: "#{@deck.tag}",
  title: "#{@deck.name}",
  description: "#{@deck.description}" %>

  <%# Stats Grid %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
    <%# Total Card %>
    <div
      class="
        bg-white dark:bg-slate-900 p-8 rounded-[2rem] border border-slate-100
        dark:border-slate-800 shadow-sm transition-all hover:shadow-md
      "
    >
      <div class="flex items-center justify-between mb-6">
        <div class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-800 text-[#60c2a6]">
          <span class="material-symbols-outlined text-2xl">style</span>
        </div>
        <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Total</span>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="text-4xl font-black text-slate-900 dark:text-white"><%= @deck.flashcards.count %></span>
        <span class="text-xs font-bold text-emerald-500">+<%= @deck.flashcards.created_this_week.count %>
          esta semana</span>
      </div>
    </div>

    <%# Status Card - Com visual de Chips %>
    <div
      class="
        bg-white dark:bg-slate-900 p-8 rounded-[2rem] border border-slate-100
        dark:border-slate-800 shadow-sm md:col-span-2 lg:col-span-1
      "
    >
      <div class="flex items-center justify-between mb-6 text-[#60c2a6]">
        <div class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-800">
          <span class="material-symbols-outlined text-2xl">monitoring</span>
        </div>
        <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Progresso</span>
      </div>
      <div class="flex flex-wrap gap-2">
        <span
          class="
            px-2 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-[9px] font-bold
            uppercase tracking-tighter text-slate-500
          "
        >
          Novos:
          <%= @status_counts[:new] %>
        </span>
        <span
          class="
            px-2 py-1 rounded-lg bg-amber-50 dark:bg-amber-900/20 text-[9px] font-bold
            uppercase tracking-tighter text-amber-600 dark:text-amber-400
          "
        >
          Lendo:
          <%= @status_counts[:learning] %>
        </span>
        <span
          class="
            px-2 py-1 rounded-lg bg-rose-50 dark:bg-rose-900/20 text-[9px] font-bold
            uppercase tracking-tighter text-rose-600 dark:text-rose-400
          "
        >
          Rever:
          <%= @status_counts[:relearning] %>
        </span>
        <span
          class="
            px-2 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-900/20 text-[9px] font-bold
            uppercase tracking-tighter text-emerald-600 dark:text-emerald-400
          "
        >
          OK:
          <%= @status_counts[:review] %>
        </span>
      </div>
    </div>

    <%# Review Card - Destaque para o que é urgente %>
    <div
      class="
        bg-white dark:bg-slate-900 p-8 rounded-[2rem] border border-slate-100
        dark:border-slate-800 shadow-sm
      "
    >
      <div class="flex items-center justify-between mb-6">
        <div
          class="
            p-3 rounded-2xl bg-emerald-50 dark:bg-emerald-900/30 text-[#60c2a6]
          "
        >
          <span class="material-symbols-outlined text-2xl">notification_important</span>
        </div>
        <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Para agora</span>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="text-4xl font-black text-[#60c2a6]"><%= @deck.flashcards.due.count %></span>
        <span class="text-xs font-bold text-slate-400 uppercase">pendentes</span>
      </div>
    </div>

    <%# Last Review Card %>
    <div
      class="
        bg-white dark:bg-slate-900 p-8 rounded-[2rem] border border-slate-100
        dark:border-slate-800 shadow-sm
      "
    >
      <div class="flex items-center justify-between mb-6">
        <div class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-800 text-[#60c2a6]">
          <span class="material-symbols-outlined text-2xl">calendar_today</span>
        </div>
        <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Última Sessão</span>
      </div>
      <div
        class="
          text-xl font-black text-slate-900 dark:text-white uppercase tracking-tight
        "
      >
        <%= if @deck.last_reviewed_at.nil?
          "Inédito"
        else
          l(@deck.last_reviewed_at, format: "%d de %B")
        end %>
      </div>
    </div>
  </div>

  <%# Seção de Flashcards %>
  <div class="space-y-8">
    <div
      class="
        flex items-end justify-between border-b border-slate-100 dark:border-slate-800
        pb-4
      "
    >
      <h2
        class="
          text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tight
        "
      >Flashcards</h2>
      <span
        class="
          px-4 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-xs font-bold
          text-slate-500
        "
      >
        <%= @deck.flashcards.count %>
        cards no total
      </span>
    </div>

    <% if @deck.flashcards.any? %>
      <div class="grid grid-cols-1 gap-4">
        <%= render partial: "flashcards", locals: { flashcards: @flashcards, deck: @deck } %>
      </div>
    <% else %>
      <%# Empty State %>
      <div
        class="
          group flex flex-col items-center justify-center rounded-[3rem] border-2
          border-dashed border-slate-200 dark:border-slate-800 bg-slate-50/50
          dark:bg-slate-900/50 p-16 transition-all hover:border-[#60c2a6] hover:bg-white
          dark:hover:bg-slate-800
        "
      >
        <%= link_to new_deck_flashcard_path(@deck), class: "flex flex-col items-center" do %>
          <div
            class="
              mb-6 flex h-24 w-24 items-center justify-center rounded-3xl bg-white
              dark:bg-slate-800 text-slate-300 group-hover:bg-[#60c2a6] group-hover:text-white
              transition-all shadow-xl shadow-slate-200/50 dark:shadow-none
            "
          >
            <span class="material-symbols-outlined text-5xl">add</span>
          </div>
          <p class="text-xl font-black text-slate-900 dark:text-white">Seu deck está vazio</p>
          <p class="mt-2 text-center text-sm text-slate-500 dark:text-slate-400 max-w-xs">
            Comece adicionando seu primeiro flashcard para ativar este deck.
          </p>
        <% end %>
      </div>
    <% end %>
  </div>
</main>
