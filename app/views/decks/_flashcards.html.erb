<div class="space-y-3">
  <% flashcards.each do |flashcard| %>
    <div
      class="
        group bg-white dark:bg-slate-900 p-4 rounded-lg border border-slate-200
        dark:border-slate-800 shadow-sm flex items-center justify-between transition-all
        hover:border-primary/30
      "
    >
      <div class="flex items-center gap-4">
        <!-- Action buttons moved to LEFT -->
        <div class="flex items-center gap-1">
          <%= link_to edit_deck_flashcard_path(deck, flashcard),
            class: "
              flex p-2 hover:bg-slate-100 dark:hover:bg-slate-800 rounded text-slate-400
              hover:text-primary transition-colors
            ", title: "Editar" do %>
            <span class="material-symbols-outlined text-[20px]">edit</span>
          <% end %>
          <%= button_to deck_flashcard_path(deck, flashcard), method: :delete,
            class: "
              flex p-2 hover:bg-red-50 dark:hover:bg-red-900/20 rounded text-slate-400
              hover:text-red-500 transition-colors
            ", title: "Deletar" do %>
            <span class="material-symbols-outlined text-[20px]">delete</span>
          <% end %>
        </div>
        <div class="h-8 w-px bg-slate-100 dark:bg-slate-800 mx-1"></div>
        <div class="flex flex-col">
          <span class="text-slate-900 dark:text-slate-100 font-medium"><%= flashcard.front.truncate(60) %></span>
        </div>
      </div>
      <div class="hidden md:flex items-center gap-2">
        <%= fsrs_state_badge(flashcard) %>
      </div>
    </div>
  <% end %>
</div>
<%= paginate flashcards %>
