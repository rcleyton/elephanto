<%= form_with url: delete_account_settings_path, class: "space-y-4", data: { controller: "password-form" }, method: :delete do |form| %>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <div>
    <%= form.label :username, class: "ui-label" %>
    <%= form.text_field :username, 
            required: true, 
            placeholder: "Seu nome de usuário",
            class: "ui-input mt-2",
            data: { password_form_target: "username", 
            action: "input->password-form#toggleDeleteAccountButton" } %>
  </div>
  <div>
    <%= form.label "Senha", class: "ui-label" %>
    <%= form.password_field :current_password,
          id: "current_password_delete",
          required: true, 
          placeholder: "Digite sua nova senha",
          class: "ui-input mt-2",
          data: { password_form_target: "currentPassword", 
          action: "input->password-form#toggleDeleteAccountButton" } %>
  </div>
</div>
<%= form.submit "Excluir conta", 
        class: "btn btn-default-size btn-destructive w-full md:w-auto", 
        data: { password_form_target: "submit" }, 
        disabled: true %>
<% end %>