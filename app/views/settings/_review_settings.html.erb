<%= turbo_frame_tag "review_settings_form" do %>
  <%= form_with model: @profile, url: daily_limit_settings_path, method: :patch, class: "space-y-8", data: { turbo_frame: "settings_form" } do |form| %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

      <%# Limite de Novos Cards %>
      <div class="space-y-3">
        <%= form.label :daily_new_limit, "Novos Cards / Dia", class: "form-label" %>
        <div class="relative group">
          <span
            class="
              material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2
              text-slate-400 group-focus-within:text-[#60c2a6] transition-colors
            "
          >speed</span>
          <%= form.number_field :daily_new_limit,
                            placeholder: "Ex: 20",
                            class: "form-input #{error_class(@profile, :daily_new_limit)}" %>
        </div>
        <div class="flex items-center gap-2 px-1">
          <span class="material-symbols-outlined text-amber-500 text-sm">lightbulb</span>
          <p class="text-[11px] font-bold text-slate-400 leading-tight">
            Sugestão:
            <span class="text-slate-600 dark:text-slate-200">15-30</span>
            para manter o ritmo sem sobrecarregar.
          </p>
        </div>
        <% if @profile.errors[:daily_new_limit].any? %>
          <p class="text-[11px] font-bold text-red-500 mt-1 ml-1 flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">error</span>
            <%= @profile.errors[:daily_new_limit].first %>
          </p>
        <% end %>
      </div>

      <%# Limite de Revisões %>
      <div class="space-y-3">
        <%= form.label :daily_review_limit, "Máximo de Revisões / Dia", class: "form-label" %>
        <div class="relative group">
          <span
            class="
              material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2
              text-slate-400 group-focus-within:text-[#60c2a6] transition-colors
            "
          >rebase_edit</span>
          <%= form.number_field :daily_review_limit,
                            placeholder: "Ex: 100",
                            class:
                              "form-input #{error_class(@profile, :daily_review_limit)}" %>
        </div>
        <div class="flex items-center gap-2 px-1">
          <span class="material-symbols-outlined text-indigo-500 text-sm">info</span>
          <p class="text-[11px] font-bold text-slate-400 leading-tight">
            Sugestão:
            <span class="text-slate-600 dark:text-slate-200">5x</span>
            o número de novos cartões.
          </p>
        </div>
        <% if @profile.errors[:daily_review_limit].any? %>
          <p class="text-[11px] font-bold text-red-500 mt-1 ml-1 flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">error</span>
            <%= @profile.errors[:daily_review_limit].first %>
          </p>
        <% end %>
      </div>

    </div>

    <%# Botão Salvar %>
    <div class="flex justify-end pt-4">
      <%= form.submit "Salvar Preferências",
                  class:
                    "w-full sm:w-auto px-10 py-4 bg-slate-900 dark:bg-[#60c2a6] text-white dark:text-slate-900 rounded-2xl font-black uppercase tracking-widest text-xs hover:scale-[1.02] active:scale-[0.98] transition-all shadow-xl shadow-slate-200 dark:shadow-none cursor-pointer" %>
    </div>
  <% end %>
<% end %>
