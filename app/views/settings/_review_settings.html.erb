<%= turbo_frame_tag "review_settings_form" do %>
  <%= form_with model: @profile, url: daily_limit_settings_path, method: :patch, data: { turbo_frame: "settings_form" } do |form| %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <%= form.label :daily_new_limit, class: "ui-label" %>
        <%= form.number_field :daily_new_limit, class: "ui-input #{error_class(@profile, :daily_new_limit)} mt-2" %>
        <% if @profile.errors[:daily_new_limit].any? %>
          <p class="ui-error"><%= Profile.human_attribute_name(:daily_new_limit) %>
          <%= @profile.errors[:daily_new_limit].first %></p>
        <% end %>
      </div>
       <div>
        <%= form.label :daily_review_limit, class: "ui-label" %>
        <%= form.number_field :daily_review_limit, class: "ui-input #{error_class(@profile, :daily_review_limit)} mt-2" %>
        <% if @profile.errors[:daily_review_limit].any? %>
          <p class="ui-error"><%= Profile.human_attribute_name(:daily_review_limit) %>
        <%= @profile.errors[:daily_review_limit].first %></p>
        <% end %>
      </div>
    </div>
    <%= form.submit "Atualizar limites", class: "btn btn-default-size btn-default-variant mt-2.5 w-full md:w-auto" %>
  <% end %>
<% end %>
