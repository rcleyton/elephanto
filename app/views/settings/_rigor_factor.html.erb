<%= turbo_frame_tag "rigor_factor_form" do %>
  <%= form_with model: @profile, url: rigor_factor_settings_path, method: :patch, data: { turbo_frame: "settings_form", controller: "rigor-factor" } do |form| %>
    <div>
      <%= form.label :rigor_factor, class: "ui-label" %>
      <%= form.select :rigor_factor,
                  options_for_select(
                    [
                      ["Relaxado (Retenção 80%)", 4.0],
                      ["Normal (Retenção 90%)", 9.0],
                      ["Rigoroso (Retenção 95%)", 19.0],
                      ["Máximo (Retenção 97%)", 32.3],
                    ],
                    @profile.rigor_factor,
                  ),
                  {},
                  class: "ui-input appearance-none md:w-48 mt-2",
                  data: {
                    "rigor-factor-target": "select",
                    action: "change->rigor-factor#updateDescription",
                  } %>
      <p class="text-sm text-muted-foreground mt-1">Controla a frequência de repetição dos flashcards</p>
      <div
        data-rigor-factor-target="description"
        class="
          text-sm text-foreground mt-2 p-3 bg-background rounded">
      </div>
    </div>
    <%= form.submit "Atualizar velocidade",
                class:
                  "btn btn-default-size btn-default-variant mt-2.5 w-full md:w-auto" %>
  <% end %>
<% end %>
