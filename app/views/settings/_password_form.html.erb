<%= turbo_frame_tag "password_settings_form" do %>
  <%= form_with url: update_password_settings_path, method: :patch, class: "space-y-4", data: { controller: "password-form" } do |form| %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <%= form.label "Senha atual", class: "text-sm font-medium leading-none" %>
        <%= form.password_field :current_password,
              required: true,
              placeholder: "Digite sua senha atual",
              class: "flex h-10 w-full rounded-md border border-gray-300 bg-[#F9FAFB] px-3 py-2 text-base md:text-sm focus-visible:ring-2 focus-visible:outline-none focus-visible:ring-blue-500 disabled:opacity-50",
              data: { password_form_target: "currentPassword", action: "input->password-form#toggleChangePasswordButton" } %>
      </div>
      <div>
        <%= form.label "Senha", class: "text-sm font-medium leading-none" %>
        <%= form.password_field :password,
              required: true,
              placeholder: "Digite sua nova senha",
              class: "flex h-10 w-full rounded-md border border-gray-300 bg-[#F9FAFB] px-3 py-2 text-base md:text-sm focus-visible:ring-2 focus-visible:outline-none focus-visible:ring-blue-500 disabled:opacity-50",
              data: { password_form_target: "password", action: "input->password-form#toggleChangePasswordButton" } %>
      </div>
      <div>
        <%= form.label "Confirmar senha", class: "text-sm font-medium leading-none" %>
        <%= form.password_field :password_confirmation,
              required: true,
              placeholder: "Confirme sua nova senha",
              class: "flex h-10 w-full rounded-md border border-gray-300 bg-[#F9FAFB] px-3 py-2 text-base md:text-sm focus-visible:ring-2 focus-visible:outline-none focus-visible:ring-blue-500 disabled:opacity-50",
              data: { password_form_target: "passwordConfirmation", action: "input->password-form#toggleChangePasswordButton" } %>
      </div>
    </div>

    <%= form.submit "Alterar senha",
          class: "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium bg-[#594CE6] text-white hover:bg-[#594CE6]/90 shadow-md transition h-10 px-4 py-2 w-full md:w-auto disabled:opacity-50 disabled:pointer-events-none",
          data: { password_form_target: "submit" },
          disabled: true %>
  <% end %>
<% end %>
