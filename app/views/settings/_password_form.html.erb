<%= turbo_frame_tag "settings_form" do %>
  <%= form_with url: update_password_settings_path, method: :patch, class: "space-y-4" do |form| %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <%= form.label "Senha atual", class: "text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" %>
        <%= form.password_field :current_password, required: true, placeholder: "Digite sua senha atual", class: "flex h-10 w-full rounded-md border border-gray-300 bg-[#F9FAFB] px-3 py-2 text-base ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm" %>
      </div>
      <div>
        <%= form.label "Senha", class: "text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" %>
        <%= form.password_field :password, required: true, placeholder: "Digite sua nova senha", class: "flex h-10 w-full rounded-md border border-gray-300 bg-[#F9FAFB] px-3 py-2 text-base ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm" %>
      </div>
      <div>
        <%= form.label "Confirmar senha", class: "text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" %>
        <%= form.password_field :password_confirmation, required: true, placeholder: "Confirme sua nova senha", class: "flex h-10 w-full rounded-md border border-gray-300 bg-[#F9FAFB] px-3 py-2 text-base ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm" %>
      </div>
    </div>
    <%= form.submit "Alterar senha", class: "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 bg-[#594CE6] text-white hover:bg-[#594CE6]/90 shadow-ls hover:shadow-xl transition-smooth h-10 px-4 py-2 w-full md:w-auto" %>
  <% end %>
<% end %>
