<%= form_with url: delete_account_settings_path,
    method: :delete,
    class: "space-y-6",
    data: { controller: "password-form" } do |form| %>

  <div
    class="
      bg-red-50 dark:bg-red-500/5 rounded-2xl p-4 border border-red-100
      dark:border-red-500/10
    "
  >
    <p
      class="
        text-xs font-bold text-red-600 dark:text-red-400 uppercase tracking-widest mb-2
        flex items-center gap-2
      "
    >
      <span class="material-symbols-outlined text-sm">verified_user</span>
      Verificação Necessária
    </p>
    <p
      class="
        text-sm text-slate-600 dark:text-slate-400 leading-relaxed font-medium
      "
    >
      Para prosseguir, digite seu usuário
      <span
        class="
          bg-red-100 dark:bg-red-500/20 px-1.5 py-0.5 rounded text-red-700
          dark:text-red-300 font-black
        "
      ><%= current_user.profile.username %></span>
      e sua senha mestre abaixo.
    </p>
  </div>

  <div class="space-y-4">
    <div class="space-y-2">
      <%= form.label :username, "Confirmar Usuário", class: "form-label" %>
      <div class="relative group">
        <span
          class="
            material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2
            text-slate-400 group-focus-within:text-red-500 transition-colors
          "
        >person_pin</span>
        <%= form.text_field :username,
                        required: true,
                        placeholder: "Digite seu username",
                        class: "form-input",
                        data: {
                          password_form_target: "username",
                          action: "input->password-form#toggleDeleteAccountButton",
                        } %>
      </div>
    </div>

    <%# Campo: Senha %>
    <div class="space-y-2">
      <%= form.label :current_password, "Sua Senha", class: "form-label" %>
      <div class="relative group">
        <span
          class="
            material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2
            text-slate-400 group-focus-within:text-red-500 transition-colors
          "
        >lock</span>
        <%= form.password_field :current_password,
                            id: "current_password_delete",
                            required: true,
                            placeholder: "Digite sua senha",
                            class: "form-input",
                            data: {
                              password_form_target: "currentPassword",
                              action: "input->password-form#toggleDeleteAccountButton",
                            } %>
      </div>
    </div>
  </div>

  <%# Footer do Form: Botões %>
  <div
    class="
      flex flex-col sm:flex-row items-center justify-end gap-3 pt-4 border-t
      border-slate-100 dark:border-slate-800
    "
  >
    <button
      type="button"
      command="close"
      commandfor="dialog"
      class="
        w-full sm:w-auto px-6 py-4 text-[11px] font-black uppercase tracking-widest
        text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition-all
      "
    >
      Manter minha conta
    </button>

    <%= form.submit "Confirmar Exclusão",
                disabled: true,
                class:
                  "w-full sm:w-auto px-8 py-4 bg-red-600 text-white rounded-2xl font-black uppercase tracking-widest text-[11px] shadow-xl shadow-red-600/20 transition-all cursor-pointer disabled:opacity-30 disabled:grayscale disabled:cursor-not-allowed",
                data: {
                  password_form_target: "submit",
                } %>
  </div>
<% end %>
