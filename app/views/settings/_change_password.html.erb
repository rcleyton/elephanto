<%= turbo_frame_tag "change_password_form" do %>
  <%= form_with url: change_password_settings_path, method: :patch, class: "space-y-6", data: { controller: "password-form" } do |form| %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <%# Senha Atual - Ocupa a linha toda %>
      <div class="col-span-1 md:col-span-2 space-y-2">
        <%= form.label :current_password, "Senha Atual", class: "form-label" %>
        <div class="relative group">
          <span
            class="
              material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2
              text-slate-400 group-focus-within:text-[#60c2a6] transition-colors
            "
          >lock_open</span>
          <%= form.password_field :current_password,
                              id: "current_password_update",
                              required: true,
                              placeholder: "Sua senha secreta atual",
                              class: "form-input",
                              data: {
                                password_form_target: "currentPassword",
                                action: "input->password-form#toggleChangePasswordButton",
                              } %>
        </div>
      </div>

      <%# Nova Senha %>
      <div class="space-y-2">
        <%= form.label :password, "Nova Senha", class: "form-label" %>
        <div class="relative group">
          <span
            class="
              material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2
              text-slate-400 group-focus-within:text-[#60c2a6] transition-colors
            "
          >lock</span>
          <%= form.password_field :password,
                              required: true,
                              placeholder: "Nova senha forte",
                              class: "form-input #{error_class(current_user, :password)}",
                              data: {
                                password_form_target: "password",
                                action: "input->password-form#toggleChangePasswordButton",
                              } %>
        </div>
        <% if current_user.errors[:password].any? %>
          <p class="text-[11px] font-bold text-red-500 mt-1 ml-1 flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">error</span>
            <%= current_user.errors[:password].first %>
          </p>
        <% end %>
      </div>

      <%# Confirmar Senha %>
      <div class="space-y-2">
        <%= form.label :password_confirmation, "Confirmar Senha", class: "form-label" %>
        <div class="relative group">
          <span
            class="
              material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2
              text-slate-400 group-focus-within:text-[#60c2a6] transition-colors
            "
          >enhanced_encryption</span>
          <%= form.password_field :password_confirmation,
                              required: true,
                              placeholder: "Repita a nova senha",
                              class:
                                "form-input #{error_class(current_user, :password_confirmation)}",
                              data: {
                                password_form_target: "passwordConfirmation",
                                action: "input->password-form#toggleChangePasswordButton",
                              } %>
        </div>
        <% if current_user.errors[:password_confirmation].any? %>
          <p class="text-[11px] font-bold text-red-500 mt-1 ml-1 flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">error</span>
            <%= current_user.errors[:password_confirmation].first %>
          </p>
        <% end %>
      </div>
    </div>

    <%# Botão de Ação %>
    <div class="flex justify-end pt-4">
      <%= form.submit "Atualizar Senha",
                  class:
                    "w-full sm:w-auto px-10 py-4 bg-slate-900 dark:bg-[#60c2a6] text-white dark:text-slate-900 rounded-2xl font-black uppercase tracking-widest text-xs hover:scale-[1.02] active:scale-[0.98] transition-all shadow-xl shadow-slate-200 dark:shadow-none cursor-pointer disabled:opacity-30 disabled:grayscale disabled:cursor-not-allowed disabled:hover:scale-100",
                  data: {
                    password_form_target: "submit",
                  },
                  disabled: true %>
    </div>
  <% end %>
<% end %>
