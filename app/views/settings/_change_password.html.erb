<%= turbo_frame_tag "change_password_form" do %>
  <%= form_with url: change_password_settings_path, method: :patch, class: "p-6 space-y-4", data: { controller: "password-form" } do |form| %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="col-span-1 md:col-span-2">
        <%= form.label "Senha atual",
                   class:
                     "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
        <%= form.password_field :current_password,
                            id: "current_password_update",
                            required: true,
                            placeholder: "Digite sua senha atual",
                            class:
                              "w-full rounded-lg border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 focus:ring-primary focus:border-primary text-sm py-3 px-4",
                            data: {
                              password_form_target: "currentPassword",
                              action: "input->password-form#toggleChangePasswordButton",
                            } %>
      </div>

      <div>
        <%= form.label "Senha",
                   class:
                     "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
        <%= form.password_field :password,
                            required: true,
                            placeholder: "Digite sua nova senha",
                            class:
                              "w-full rounded-lg border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 focus:ring-primary focus:border-primary text-sm py-3 px-4 #{error_class(current_user, :password)}",
                            data: {
                              password_form_target: "password",
                              action: "input->password-form#toggleChangePasswordButton",
                            } %>
        <% if current_user.errors[:password].any? %>
          <p class="ui-error"><%# User.human_attribute_name(:password) %>
            <%= current_user.errors[:password].first %></p>
        <% end %>
      </div>

      <div>
        <%= form.label "Confirmar senha",
                   class:
                     "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
        <%= form.password_field :password_confirmation,
                            required: true,
                            placeholder: "Confirme sua nova senha",
                            class:
                              "w-full rounded-lg border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 focus:ring-primary focus:border-primary text-sm py-3 px-4 #{error_class(current_user, :password_confirmation)}",
                            data: {
                              password_form_target: "passwordConfirmation",
                              action: "input->password-form#toggleChangePasswordButton",
                            } %>
        <% if current_user.errors[:password_confirmation].any? %>
          <p class="ui-error"><%# User.human_attribute_name(:password_confirmation) %>
            <%= current_user.errors[:password_confirmation].first %></p>
        <% end %>

      </div>
    </div>
    <div class="flex justify-end pt-2">
      <%= form.submit "Alterar senha",
                  class:
                    "bg-primary hover:bg-primary/90 text-white font-semibold py-2.5 px-6 rounded-lg transition-all shadow-sm",
                  data: {
                    password_form_target: "submit",
                  },
                  disabled: true %>
    </div>
  <% end %>
<% end %>
