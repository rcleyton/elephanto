<% content_for :title, "Configurações • Elephanto" %>

<turbo-frame id="flash">
  <%= render "shared/flash" %>
</turbo-frame>

<main class="flex flex-1 justify-center py-12 px-4 sm:px-6">
  <div class="max-w-[800px] flex-1">

    <%# Header de Configurações %>
    <div
      class="
        flex flex-col gap-2 pb-12 animate-in fade-in slide-in-from-top-4 duration-700
      "
    >
      <div class="flex items-center gap-3 mb-1">
        <div class="h-1 w-8 bg-[#60c2a6] rounded-full"></div>
        <span class="text-[10px] font-black uppercase tracking-[0.3em] text-[#60c2a6]">User Preferences</span>
      </div>
      <h1 class="text-4xl font-black tracking-tighter text-slate-900 dark:text-white">
        Configurações
      </h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm font-medium">
        Personalize sua experiência e gerencie sua segurança.
      </p>
    </div>

    <div
      class="
        space-y-6 animate-in fade-in slide-in-from-bottom-6 duration-1000 delay-200
      "
    >

      <%# 1. Aparência (Toggle Rápido) %>
      <section
        data-controller="theme"
        class="
          bg-white dark:bg-slate-900 rounded-[2rem] shadow-xl shadow-slate-200/50
          dark:shadow-none border border-slate-100 dark:border-slate-800 transition-all
          overflow-hidden group
        "
      >
        <div class="flex justify-between items-center px-8 py-6">
          <div class="flex items-center gap-5">
            <div
              class="
                size-12 rounded-2xl bg-amber-50 dark:bg-amber-500/10 flex items-center
                justify-center text-amber-500 group-hover:rotate-12 transition-transform
              "
            >
              <span
                data-theme-target="icon"
                class="material-symbols-outlined font-bold text-2xl"
              >light_mode</span>
            </div>
            <div>
              <p class="font-black text-slate-900 dark:text-white tracking-tight">Interface</p>
              <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Modo Claro ou Escuro</p>
            </div>
          </div>

          <button
            aria-label="Alternar tema"
            data-action="click->theme#toggle"
            class="
              group relative inline-flex h-8 w-14 items-center rounded-full bg-slate-100
              dark:bg-slate-800 transition-colors focus:outline-none
            "
          >
            <span class="sr-only">Toggle Theme</span>
            <span
              class="
                inline-block size-6 transform rounded-full bg-white dark:bg-[#60c2a6] shadow-md
                transition-transform translate-x-1 dark:translate-x-7
              "
            ></span>
          </button>
        </div>
      </section>

      <%# 2. Segurança %>
      <section
        class="
          bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-xl shadow-slate-200/50
          dark:shadow-none border border-slate-100 dark:border-slate-800 overflow-hidden
        "
      >
        <div
          class="
            px-8 py-6 border-b border-slate-50 dark:border-slate-800 flex items-center gap-4
            bg-slate-50/50 dark:bg-slate-800/20
          "
        >
          <div
            class="
              size-10 rounded-xl bg-indigo-50 dark:bg-indigo-500/10 flex items-center
              justify-center text-indigo-500
            "
          >
            <span class="material-symbols-outlined text-xl font-bold">lock</span>
          </div>
          <h3
            class="
              text-sm font-black uppercase tracking-[0.15em] text-slate-700
              dark:text-slate-200
            "
          >Segurança da Conta</h3>
        </div>
        <div class="p-8 sm:p-10">
          <%= render "settings/change_password", user: current_user %>
        </div>
      </section>

      <%# 3. Preferências de Estudo %>
      <section
        class="
          bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-xl shadow-slate-200/50
          dark:shadow-none border border-slate-100 dark:border-slate-800 overflow-hidden
        "
      >
        <div
          class="
            px-8 py-6 border-b border-slate-50 dark:border-slate-800 flex items-center gap-4
            bg-slate-50/50 dark:bg-slate-800/20
          "
        >
          <div
            class="
              size-10 rounded-xl bg-[#60c2a6]/10 flex items-center justify-center
              text-[#60c2a6]
            "
          >
            <span class="material-symbols-outlined text-xl font-bold">school</span>
          </div>
          <h3
            class="
              text-sm font-black uppercase tracking-[0.15em] text-slate-700
              dark:text-slate-200
            "
          >Algoritmo & Revisão</h3>
        </div>
        <div class="p-8 sm:p-10">
          <%= render "settings/review_settings", user: current_user %>
        </div>
      </section>

      <%# 4. Zona de Perigo %>
      <section
        class="
          bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-xl shadow-slate-200/50
          dark:shadow-none border border-slate-100 dark:border-slate-800 overflow-hidden
        "
      >
        <div
          class="
            px-8 py-6 border-b border-red-50 dark:border-red-950/30 flex items-center gap-4
            bg-red-50/30 dark:bg-red-900/10
          "
        >
          <div
            class="
              size-10 rounded-xl bg-red-50 dark:bg-red-500/10 flex items-center justify-center
              text-red-500
            "
          >
            <span class="material-symbols-outlined text-xl font-bold">warning</span>
          </div>
          <h3
            class="
              text-sm font-black uppercase tracking-[0.15em] text-red-600 dark:text-red-400
            "
          >Zona Crítica</h3>
        </div>
        <div
          class="
            p-8 sm:p-10 space-y-10 divide-y divide-slate-100 dark:divide-slate-800
          "
        >
          <div class="animate-in fade-in duration-500">
            <%= render "settings/remove_deck", user: current_user %>
          </div>
          <div>
            <%= render "settings/delete_account", user: current_user %>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>
