<%= turbo_frame_tag "remove_deck_form" do %>
  <% if current_user.decks.any? %>
    <%= form_with url: remove_deck_settings_path, method: :delete do |form| %>
      <div
        class="
          flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8
          group mb-8
        "
      >

        <div class="flex-1 space-y-2">
          <div class="flex items-center gap-2">
            <h4 class="font-black text-slate-900 dark:text-white tracking-tight">Excluir Deck Específico</h4>
            <span
              class="
                px-2 py-0.5 rounded-md bg-red-50 dark:bg-red-500/10 text-[9px] font-black
                text-red-500 uppercase tracking-tighter
              "
            >Permanente</span>
          </div>
          <p
            class="
              text-sm font-medium text-slate-500 dark:text-slate-400 max-w-md leading-relaxed
            "
          >
            Esta ação não pode ser desfeita. O deck e todo o seu progresso de
            memorização serão
            <span class="text-red-500 font-bold">apagados para sempre</span>.
          </p>

          <div class="mt-4 relative max-w-xs group/select">
            <span
              class="
                material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2
                text-slate-400 group-focus-within/select:text-red-500 transition-colors text-xl
              "
            >folder_delete</span>
            <%= form.select :deck_id,
                        current_user.decks.order(:name).pluck(:name, :id),
                        { prompt: "Selecione um deck..." },
                        class:
                          "block w-full rounded-2xl border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/50 py-3 pl-12 pr-10 text-sm font-bold text-slate-900 dark:text-white focus:ring-4 focus:ring-red-500/10 focus:border-red-500/40 transition-all appearance-none cursor-pointer" %>
            <span
              class="
                material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2
                text-slate-400 pointer-events-none
              "
            >unfold_more</span>
          </div>
        </div>

        <div class="w-full lg:w-auto">
          <%= form.submit "Excluir Deck",
                      class:
                        "w-full lg:w-auto px-8 py-4 bg-white dark:bg-slate-900 text-red-500 border-2 border-red-100 dark:border-red-900/30 rounded-2xl font-black uppercase tracking-widest text-[11px] hover:bg-red-500 hover:text-white hover:border-red-500 transition-all duration-300 shadow-sm active:scale-95",
                      data: {
                        turbo_confirm:
                          "Tem certeza que deseja excluir permanentemente este deck e todos os seus cards?",
                      } %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="flex flex-col items-center justify-center py-4 mb-8 text-center">
      <div
        class="
          size-12 rounded-full bg-slate-50 dark:bg-slate-800 flex items-center
          justify-center mb-3
        "
      >
        <span class="material-symbols-outlined text-slate-300">inventory_2</span>
      </div>
      <p class="text-sm font-bold text-slate-400 uppercase tracking-widest">Sua biblioteca está vazia</p>
    </div>
  <% end %>
<% end %>
