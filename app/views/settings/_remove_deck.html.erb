<turbo-frame id="remove_deck_form">
  <% if current_user.decks.any? %>
    <%= form_with url: remove_deck_settings_path, method: :delete do |form| %>
      <div>
        <%= form.label "Selecione um deck para excluir", class: "ui-label" %>
        <%= form.select :deck_id, user.decks.order(:name).pluck(:name, :id), {}, class: "ui-input md:w-48 appearance-none" %>
      </div>
      <p class="text-sm text-red-700 mt-1">Todos os flashcards do deck serão excluídos</p>
      <%= form.submit "Excluir selecionado", class: "inline-flex mt-2.5 items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 bg-primary text-primary-foreground hover:bg-primary/90 shadow-elegant hover:shadow-glow transition-smooth h-10 px-4 py-2 w-full md:w-auto", data: { turbo_confirm: "Tem certeza que deseja excluir este deck?" } %>
    <% end %>
  <% else %>
    <p class="text-sm text-muted-foreground">Você não possui nenhum deck para apagar.</p>
  <% end %>
</turbo-frame>

