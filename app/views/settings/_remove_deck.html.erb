<%= turbo_frame_tag "remove_deck_form" do %>
  <% if current_user.decks.any? %>
    <%= form_with url: remove_deck_settings_path, method: :delete do |form| %>
      <div class="
      flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-6
      border-b border-slate-100 dark:border-slate-800">
        <div class="flex-1">
          <h4 class="font-semibold text-slate-900 dark:text-slate-100">Excluir Deck Específico</h4>
          <p class="text-sm text-slate-500 mt-1">Isso removerá permanentemente o deck e todo o seus flashcards.</p>
          <div class="mt-3">
            <%= form.select :deck_id,
                        current_user.decks.order(:name).pluck(:name, :id),
                        {},
                        class:
                          "rounded-lg border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-sm py-2 px-3 w-full md:w-64 focus:ring-primary" %>
          </div>
        </div>
        <%= form.submit "Excluir selecionado",
            class: "text-red-500 border border-red-500/20 bg-red-50 dark:bg-red-900/10 hover:bg-red-100 dark:hover:bg-red-900/20 font-semibold py-2 px-4 rounded-lg text-sm transition-all",
            data: { turbo_confirm: "Tem certeza que deseja excluir este deck?" } %>
        <% end %>
    </div>
  <% else %>
    <p class="text-sm text-muted-foreground pb-6 border-b border-slate-100 dark:border-slate-800">Você não possui nenhum deck para apagar.</p>
  <% end %>
<% end %>
