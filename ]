<%= turbo_frame_tag "remove_deck_form" do %>
  <div
    class="
      flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-6
      border-b border-slate-100 dark:border-slate-800
    "
  >
    <% if current_user.decks.any? %>
      <%= form_with url: remove_deck_settings_path, method: :delete do |form| %>
        <div>
          <%= form.label "Selecione um deck para excluir", class: "ui-label" %>
          <%= form.select :deck_id,
                      current_user.decks.order(:name).pluck(:name, :id),
                      {},
                      class: "ui-input md:w-48 appearance-none mt-2" %>
        </div>
        <p class="text-sm text-red-700 mt-1">Todos os flashcards do deck serão excluídos</p>
        <%= form.submit "Excluir selecionado",
                    class:
                      "btn btn-default-size btn-destructive mt-2.5 w-full md:w-auto",
                    data: {
                      turbo_confirm: "Tem certeza que deseja excluir este deck?",
                    } %>
      <% end %>
    <% else %>
      <p class="text-sm text-muted-foreground">Você não possui nenhum deck para apagar.</p>
    <% end %>
  </div>
<% end %>
